---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CallToAction from '../../components/CallToAction.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../siteConfig';

const services = await getCollection('services');

const crumbs = [
  { name: 'Services', item: '/services/' },
];
---

<BaseLayout
  title="Plumbing Services in Denton, TX | Service Directory"
  description="Explore plumbing service categories available through Denton Plumbing Pros. Connect with local specialists for water heaters, drain cleaning, slab leaks & emergency plumbing."
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="py-12 lg:py-16 bg-slate-900 text-white px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-xs uppercase font-bold tracking-widest text-brand-400">Plumbing Referral Directory</span>
      <h1 class="text-3xl sm:text-5xl font-black mt-2 mb-4 font-serif">
        Plumbing Services in Denton County, TX
      </h1>
      <p class="text-slate-300 text-base sm:text-lg">
        Fast, transparent connections with independent local plumbing contractors for North Texas homes and commercial properties.
      </p>
    </div>
  </section>

  <TrustBadges />

  <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm flex flex-col justify-between hover:border-brand-500 transition">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold uppercase px-3 py-1 bg-brand-100 text-brand-800 rounded-full">
                  {service.data.urgencyLevel}
                </span>
                <span class="text-xs text-slate-500 font-medium">
                  {service.data.estimatedStartingPrice || 'Free Estimate'}
                </span>
              </div>
              <h2 class="text-2xl font-bold text-slate-900 mb-3 hover:text-brand-600 transition">
                <a href={`/denton-tx/${service.slug}/`}>
                  {service.data.title}
                </a>
              </h2>
              <p class="text-slate-600 text-sm mb-6 leading-relaxed">
                {service.data.shortDescription}
              </p>
              
              <div class="mb-6">
                <span class="text-xs font-bold uppercase text-slate-500 tracking-wider block mb-2">Common Fixes:</span>
                <ul class="text-xs text-slate-700 space-y-1.5">
                  {service.data.problemsSolved.slice(0, 3).map((p) => (
                    <li class="flex items-center gap-2">
                      <Icon name="check" class="w-3.5 h-3.5 text-emerald-500 font-bold shrink-0" />
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/denton-tx/${service.slug}/`}
                class="text-sm font-bold text-brand-600 hover:text-brand-700"
              >
                Denton Service Details →
              </a>
              <a
                href={`tel:${siteConfig.phoneRaw}`}
                class="text-xs font-bold text-emergency-600 hover:underline flex items-center gap-1"
              >
                <Icon name="phone" class="w-3.5 h-3.5 text-red-600" />
                <span>Call Now</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
