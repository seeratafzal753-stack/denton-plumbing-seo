---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CallToAction from '../../components/CallToAction.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../siteConfig';

const services = await getCollection('services');

const crumbs = [
  { name: 'Denton, TX', item: '/denton-tx/' },
];

const faqs = [
  {
    question: "Do you offer emergency 24/7 plumbing in Denton, TX?",
    answer: "Yes. Our Denton emergency dispatch team operates 24 hours a day, 365 days a year including weekends and holidays with average arrival times of 30 to 45 minutes."
  },
  {
    question: "What plumbing problems are most common in Denton?",
    answer: "Due to North Texas expansive clay soil and mineral-heavy tap water, the most common issues in Denton are under-slab water leaks, sediment buildup in water heaters, main sewer line root intrusions, and low water pressure."
  },
  {
    question: "Are your technicians licensed in the State of Texas?",
    answer: "Yes, all our plumbers hold active licenses with the Texas State Board of Plumbing Examiners (TSBPE) and carry full commercial liability insurance."
  }
];
---

<BaseLayout
  title="Denton TX Plumber | Local Plumbing Services & 24/7 Repairs"
  description="Local Denton, TX plumbers ready for fast 24/7 dispatch. Water heaters, clogged drains, slab leak detection & emergency repairs across all Denton ZIPs."
  breadcrumbs={crumbs}
  faqs={faqs}
>
  <Breadcrumbs crumbs={crumbs} />

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-brand-950 to-slate-900 text-white py-12 lg:py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 bg-brand-600/90 text-white text-xs uppercase font-bold tracking-widest px-3.5 py-1.5 rounded-full mb-4">
          <Icon name="map-pin" class="w-3.5 h-3.5 text-white" />
          <span>Primary City Hub | Denton, Texas</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight mb-4 text-white">
          Complete Plumbing Solutions in <span class="text-brand-400">Denton, TX</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed">
          From Downtown Denton Square to Robson Ranch and Rayzor Ranch, our certified master plumbers deliver prompt, reliable, and upfront-priced plumbing services.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-emergency-600 hover:bg-emergency-500 text-white font-black text-lg shadow-xl transition"
          >
            <Icon name="phone" class="w-6 h-6 text-white" />
            <span>Call Denton Desk: {siteConfig.phone}</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <LeadForm formTitle="Book Denton Plumbing Service" />
      </div>
    </div>
  </section>

  <TrustBadges />

  <!-- Denton Money Services Silo Links -->
  <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Local Money Services</span>
        <h2 class="text-3xl font-black text-slate-900 mt-1">
          Select Your Plumbing Need in Denton
        </h2>
        <p class="text-slate-600 text-sm mt-2">
          Click below to view Denton-specific pricing, common local problems, and same-day availability:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <a
            href={`/denton-tx/${service.slug}/`}
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:border-brand-500 hover:shadow-md transition group"
          >
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold px-2.5 py-1 rounded bg-brand-50 text-brand-700">
                Denton, TX
              </span>
              <span class="text-brand-600 group-hover:translate-x-1 transition font-bold">→</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition mb-2">
              {service.data.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {service.data.shortDescription}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Neighborhoods Grid -->
  <section class="py-14 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-2xl font-black text-slate-900 text-center mb-6">
        Denton Communities &amp; Neighborhoods We Actively Serve
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 text-center">
        {siteConfig.neighborhoods.map((n) => (
          <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 flex items-center justify-center gap-1.5">
            <Icon name="map-pin" class="w-3.5 h-3.5 text-slate-400" />
            <span>{n}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion faqs={faqs} />
  <CallToAction />
</BaseLayout>
