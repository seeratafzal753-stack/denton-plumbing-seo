---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlumberMascotHero from '../components/PlumberMascotHero.astro';
import PillButton from '../components/PillButton.astro';
import ReviewCardsClean from '../components/ReviewCardsClean.astro';
import ThreeStepProcess from '../components/ThreeStepProcess.astro';
import LocalWaterSoilWidget from '../components/LocalWaterSoilWidget.astro';
import NeighborhoodExplorer from '../components/NeighborhoodExplorer.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../siteConfig';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const faqs = [
  {
    question: "What plumbing services do you provide in Denton, TX?",
    answer: "We provide comprehensive residential and commercial plumbing services across Denton County, including water heater repair and replacement (tank and tankless), non-invasive electronic slab leak detection, emergency drain cleaning with 4000 PSI hydro-jetting, whole-house PEX repiping, sewer line video inspections, and 24/7 emergency water shutoff."
  },
  {
    question: "How quickly can a licensed technician arrive at my home?",
    answer: "Our mobile response trucks are staged locally near I-35E, I-35W, and Loop 288. For emergency calls in Denton ZIP codes (76201–76226), our average arrival time is 28 to 35 minutes."
  },
  {
    question: "Why is water heater failure so common in Denton?",
    answer: "Denton municipal water (sourced from Lake Lewisville and Lake Ray Roberts) contains high mineral hardness (8.8 GPG). Without regular annual flushing, calcium and magnesium sediment crusts at the bottom of water heaters, leading to lower efficiency, loud popping noises, and premature tank corrosion."
  },
  {
    question: "Do you provide upfront quotes before starting work?",
    answer: "Yes, 100%. Our Texas Master Plumber performs a complete diagnostic and provides a transparent, flat-rate written quote before touching any tools. You will never see hidden trip charges or unexpected overtime fees."
  },
  {
    question: "How do shifting clay soils cause slab leaks in North Texas?",
    answer: "Denton is situated over expansive black clay soil with a high plasticity index (PI 42+). During hot Texas summers and heavy spring rains, the soil expands and contracts dramatically, shifting the concrete slab and cracking rigid underground copper pipes."
  }
];
---

<BaseLayout
  title="Plumber Denton TX | Reliable Plumbing Services When You Need Them Most"
  description="Reliable plumbing services in Denton, TX. 24/7 emergency plumbing, water heaters, drain cleaning, and slab leak solutions. Call (940) 310-4499."
  faqs={faqs}
>

  <!-- ========================================================= -->
  <!-- HERO SECTION (Left Text + Right Plumber Mascot Visual) -->
  <!-- ========================================================= -->
  <section class="bg-gradient-to-b from-slate-50 via-white to-slate-50 border-b border-slate-200 py-10 lg:py-16 px-4 sm:px-6 lg:px-8 overflow-hidden relative">
    
    <!-- Background Plumbing Ambient Accents -->
    <div class="absolute inset-0 bg-[radial-gradient(#e0f2fe_1px,transparent_1px)] [background-size:20px_20px] opacity-70 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
      
      <!-- LEFT SIDE OF HERO: Headline, Supporting Text, and Primary CALL NOW & BOOK NOW CTAs -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Emergency Dispatch Badge -->
        <div class="inline-flex items-center gap-2 bg-red-50 text-red-700 border border-red-200 px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider shadow-sm">
          <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
          <span>Denton County’s Trusted Local Plumber</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-5xl 2xl:text-6xl font-black text-slate-900 tracking-tight leading-[1.15] font-serif">
          Reliable Plumbing Services <br class="hidden sm:inline" />
          <span class="text-red-600">When You Need Them Most</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-xl mx-auto lg:mx-0">
          Professional plumbing services in Denton, TX & surrounding areas. Specializing in 24/7 emergency plumbing, high-efficiency water heaters, 4000 PSI drain cleaning, and non-invasive slab leak solutions.
        </p>

        <!-- Two CTA Buttons (CALL NOW as Primary) -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          
          <!-- Primary CTA: CALL NOW -->
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-red-600 hover:bg-red-700 text-white font-black text-base uppercase tracking-wider shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2.5"
          >
            <span>📞</span>
            <span>CALL NOW: (940) 310-4499</span>
          </a>

          <!-- Secondary CTA: BOOK NOW -->
          <a
            href="#estimate-form"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-black text-white font-black text-base uppercase tracking-wider shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 text-center"
          >
            BOOK NOW
          </a>

        </div>

        <!-- Trust Highlights Row -->
        <div class="pt-4 border-t border-slate-200/80 grid grid-cols-3 gap-3 text-center sm:text-left text-xs font-bold text-slate-700">
          <div class="flex items-center justify-center sm:justify-start gap-1.5">
            <span class="text-red-600 font-black">✓</span> 28-Min Avg Arrival
          </div>
          <div class="flex items-center justify-center sm:justify-start gap-1.5">
            <span class="text-red-600 font-black">✓</span> 100% Upfront Pricing
          </div>
          <div class="flex items-center justify-center sm:justify-start gap-1.5">
            <span class="text-red-600 font-black">✓</span> TX Master Plumber #M-42918
          </div>
        </div>

      </div>

      <!-- RIGHT SIDE OF HERO: Plumber Mascot Visual Element -->
      <div class="lg:col-span-5 flex justify-center">
        <PlumberMascotHero />
      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 2. "WHAT YOUR NEIGHBORS ARE SAYING" (Social Proof Cards) -->
  <!-- ========================================================= -->
  <ReviewCardsClean />

  <!-- ========================================================= -->
  <!-- 3. EDITORIAL SECTION: LOVE YOUR PLUMBING & WATER AGAIN -->
  <!-- ========================================================= -->
  <section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Graphic Card -->
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="bg-slate-100 border border-slate-200 rounded-2xl p-6 text-center shadow-sm">
          <div class="aspect-square bg-gradient-to-tr from-brand-900 via-brand-800 to-slate-900 rounded-xl flex flex-col items-center justify-center p-6 text-white relative">
            <div class="text-6xl mb-3">🔥</div>
            <span class="font-extrabold text-white text-xl font-serif">Clean, Hot Water On Demand</span>
            <span class="text-xs text-slate-300 mt-2 max-w-xs">High-efficiency tank &amp; tankless systems installed with full code compliance.</span>
          </div>
        </div>
      </div>

      <!-- Right Editorial -->
      <div class="lg:col-span-7 order-1 lg:order-2 space-y-4">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif tracking-tight">
          Love Your Plumbing &amp; Water Again
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          From hard water mineral buildup that damages appliances to sluggish bathroom drains and unexpected cold showers, plumbing breakdowns disrupt your household routine. Our specialized Denton plumbers restore optimal pressure, endless hot water, and clear drains with minimal intrusion to your home.
        </p>
        <ul class="space-y-2 text-sm text-slate-700">
          <li class="flex items-center gap-2">
            <span class="text-brand-700 font-bold">•</span> Annual water heater descaling &amp; anode protection
          </li>
          <li class="flex items-center gap-2">
            <span class="text-brand-700 font-bold">•</span> High-volume tankless conversions with 40% lower energy bills
          </li>
          <li class="flex items-center gap-2">
            <span class="text-brand-700 font-bold">•</span> Quiet, leak-free PEX water supply lines
          </li>
        </ul>
        <div class="pt-4">
          <PillButton text="Contact Us Today" href={`tel:${siteConfig.phoneRaw}`} />
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 4. 3-STEP PROCESS (With You, Every Step of the Way) -->
  <!-- ========================================================= -->
  <ThreeStepProcess />

  <!-- ========================================================= -->
  <!-- 5. EDITORIAL SECTION: UNMATCHED WARRANTIES -->
  <!-- ========================================================= -->
  <section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Editorial -->
      <div class="lg:col-span-7 space-y-4">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif tracking-tight">
          Unmatched Workmanship &amp; Warranties
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          We believe in doing the job right the first time. Every replacement water heater, repiping project, and sewer line relining is installed using premium commercial-grade components that exceed Texas plumbing codes.
        </p>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Rest easy knowing your investment is protected by our ironclad satisfaction guarantees and long-term manufacturer warranties.
        </p>
        <div class="pt-4">
          <PillButton text="Contact Us Today" href={`tel:${siteConfig.phoneRaw}`} />
        </div>
      </div>

      <!-- Right Graphic -->
      <div class="lg:col-span-5">
        <div class="bg-slate-100 border border-slate-200 rounded-2xl p-6 text-center shadow-sm">
          <div class="aspect-[4/3] bg-white rounded-xl flex flex-col items-center justify-center p-6 border border-slate-200">
            <div class="text-5xl mb-2">🛡️</div>
            <span class="font-extrabold text-slate-900 text-lg font-serif">100% Satisfaction Warranty</span>
            <span class="text-xs text-slate-500 mt-1">Written guarantee on all parts &amp; labor</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 6. EDITORIAL SECTION: LIFETIME PROTECTION & SMART CONTROLS -->
  <!-- ========================================================= -->
  <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Equipment Graphic -->
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 text-center shadow-sm">
          <div class="aspect-square bg-slate-50 rounded-xl flex flex-col items-center justify-center p-6 border border-slate-200">
            <div class="text-6xl mb-2">⚡</div>
            <span class="font-bold text-slate-900 text-base font-serif">Smart Digital Control</span>
            <span class="text-xs text-slate-500 mt-1">Navien &amp; Rheem High-Efficiency Systems</span>
          </div>
        </div>
      </div>

      <!-- Right Editorial -->
      <div class="lg:col-span-7 order-1 lg:order-2 space-y-4">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif tracking-tight">
          Lifetime Exchange &amp; Protection
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Upgrade to modern, smart plumbing technology. Our authorized technicians install digital pressure valves, smart leak detectors, and self-cleaning water heaters that automatically adjust to Denton's water chemistry.
        </p>
        <div class="pt-4">
          <PillButton text="Contact Us Today" href={`tel:${siteConfig.phoneRaw}`} />
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 7. HARD WATER & CLAY SOIL GEOLOGICAL DIAGNOSTICS -->
  <!-- ========================================================= -->
  <LocalWaterSoilWidget />

  <!-- ========================================================= -->
  <!-- 8. NEIGHBORHOOD EXPLORER GRID -->
  <!-- ========================================================= -->
  <div id="neighborhoods">
    <NeighborhoodExplorer />
  </div>

  <!-- ========================================================= -->
  <!-- 9. FAST ESTIMATE CALLBACK FORM -->
  <!-- ========================================================= -->
  <section id="estimate-form" class="py-16 bg-slate-900 text-white px-4 sm:px-6 lg:px-8 border-t border-slate-800">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-black uppercase tracking-widest text-brand-400 block mb-1">
          FAST CALLBACK ESTIMATE
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight font-serif">
          REQUEST INSTANT DENTON PLUMBING SERVICE
        </h2>
        <p class="text-slate-400 text-sm mt-2">
          Fill out the brief form below and our on-duty dispatcher will call you within 5 minutes.
        </p>
      </div>
      <LeadForm formTitle="Schedule Fast Denton Service" />
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 10. LATEST PLUMBING & HOMEOWNER GUIDES (BLOGS) -->
  <!-- ========================================================= -->
  <section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200">
    <div class="max-w-6xl mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-brand-700 block mb-1">
            Local Knowledge Base &amp; Tips
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif tracking-tight">
            Latest Denton Plumbing Guides
          </h2>
          <p class="text-slate-600 text-sm mt-1">
            Expert insights and preventive maintenance advice from our licensed master plumbers.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href="/blog/"
            class="inline-flex items-center gap-2 text-sm font-bold text-brand-700 hover:text-brand-800 hover:underline"
          >
            <span>View All Guides</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-500 transition flex flex-col justify-between group">
            <div class="p-6">
              <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
                <span class="bg-white border border-slate-200 text-brand-800 font-bold px-2.5 py-0.5 rounded-full uppercase text-[10px]">
                  {post.data.category}
                </span>
                <span>
                  {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(post.data.pubDate)}
                </span>
              </div>
              <h3 class="font-bold text-slate-900 text-base group-hover:text-brand-700 transition font-serif leading-snug mb-2">
                <a href={`/blog/${post.slug}/`}>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="px-6 py-3.5 bg-white border-t border-slate-200 flex items-center justify-between text-xs">
              <span class="text-slate-500">By {post.data.author}</span>
              <a href={`/blog/${post.slug}/`} class="font-bold text-brand-700 group-hover:translate-x-1 transition transform flex items-center gap-1">
                <span>Read Article</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 11. CLEAN FAQS ACCORDION -->
  <!-- ========================================================= -->
  <FaqAccordion faqs={faqs} />

</BaseLayout>
