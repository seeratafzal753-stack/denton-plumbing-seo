---
import BaseLayout from '../layouts/BaseLayout.astro';
import DentonLiveTicker from '../components/DentonLiveTicker.astro';
import RecentDispatches from '../components/RecentDispatches.astro';
import LocalWaterSoilWidget from '../components/LocalWaterSoilWidget.astro';
import NeighborhoodExplorer from '../components/NeighborhoodExplorer.astro';
import LeadForm from '../components/LeadForm.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CallToAction from '../components/CallToAction.astro';
import { siteConfig } from '../siteConfig';

const services = [
  {
    title: 'Water Heater Repair & Replacement',
    slug: 'water-heater-repair',
    desc: 'Rapid diagnosis and replacement for leaking tanks, pilot outages, and Lake Lewisville hard-water mineral buildup. Gas, electric & hybrid units.',
    icon: '🔥',
    badge: 'Popular',
  },
  {
    title: '24/7 Emergency Plumbing',
    slug: 'emergency-plumbing',
    desc: 'Burst pipes, overflowing toilets, major ceiling leaks, and gas line issues. Rapid 28–35 minute local Denton County dispatch.',
    icon: '⚡',
    badge: '24/7 Live',
  },
  {
    title: 'Drain Cleaning & Hydro Jetting',
    slug: 'drain-cleaning',
    desc: 'Clear severe kitchen, bathroom, and main sewer clogs with high-pressure 4000 PSI hydro jetting and fiber-optic video camera inspection.',
    icon: '🚿',
    badge: 'Same-Day',
  },
  {
    title: 'Slab Leak Detection & PEX Reroute',
    slug: 'slab-leak-repair',
    desc: 'North Texas clay soil causes severe foundation movement and underground pipe breaks. Non-invasive electronic leak detection.',
    icon: '🏠',
    badge: 'Specialist',
  },
  {
    title: 'Tankless Water Heater Installation',
    slug: 'tankless-water-heaters',
    desc: 'Endless hot water on demand with 40% lower utility bills. Authorized installers of Navien, Rinnai, Rheem, and Bradford White.',
    icon: '⚡',
    badge: 'Eco-Friendly',
  },
  {
    title: 'Sewer Line Repair & Replacement',
    slug: 'sewer-line-repair',
    desc: 'Trenchless epoxy sewer line relining to eliminate aggressive tree root intrusions and collapsed clay lines without trenching your lawn.',
    icon: '🛠️',
    badge: 'Trenchless',
  },
];

const faqs = [
  {
    question: "How fast can an emergency plumber arrive at my Denton home?",
    answer: "Our technicians are stationed locally throughout Denton County near I-35E, I-35W, and Loop 288. In emergency situations, our average response time is between 28 to 35 minutes."
  },
  {
    question: "Why do water heaters fail frequently in Denton, TX?",
    answer: "Denton's municipal water supply (sourced from Lake Lewisville & Lake Ray Roberts) contains high levels of calcium and magnesium (8.8 GPG hardness rating). Without regular annual flushing, these minerals settle at the bottom of your water heater, causing bottom tank corrosion, element burnout, and ruptures."
  },
  {
    question: "What causes slab leaks in North Texas homes?",
    answer: "Denton is built on expansive black clay soil with a high plasticity index. During hot Texas summers and sudden heavy rains, the soil expands and contracts dramatically, putting immense pressure on concrete foundations and cracking sub-slab copper and PVC water lines."
  },
  {
    question: "Do you offer upfront pricing before work begins?",
    answer: "Yes, 100%. Our Texas licensed master plumbers provide a comprehensive inspection and a transparent, upfront written quote before touching a single tool. You will never encounter hidden fees or unexpected overtime charges."
  },
  {
    question: "Which areas and ZIP codes do you serve in Denton County?",
    answer: "We serve all Denton ZIP codes including 76201, 76205, 76207, 76208, 76209, 76210, and 76226, plus surrounding towns like Corinth, Argyle, Lake Dallas, Sanger, and Little Elm."
  }
];

const reviews = [
  {
    name: "Marcus T.",
    street: "Teasley Ln, Southridge Subdivision",
    city: "Denton, TX (ZIP 76205)",
    rating: 5,
    text: "Water heater started leaking at 8 PM on a Sunday. Called Denton Plumbing Pros and a technician arrived in 30 minutes! Upfront quote, replaced the relief valve on the spot. Best plumber in Denton!",
  },
  {
    name: "Sarah K.",
    street: "Nottingham Dr (Idiots Hill)",
    city: "Denton, TX (ZIP 76209)",
    rating: 5,
    text: "Had a stubborn main drain clog that other plumbers couldn't clear. Their team ran a camera, showed me the tree root invasion, and cleared it with hydro jetting in under an hour.",
  },
  {
    name: "David R.",
    street: "Rayzor Ranch Marketplace area",
    city: "Denton, TX (ZIP 76207)",
    rating: 5,
    text: "Suspected a slab leak due to spinning water meter. Their electronic detection pin-pointed the exact hot line under our foundation and did an attic PEX reroute. Saved our hardwood floors!",
  }
];
---

<BaseLayout
  title="Plumber Denton TX | 24/7 Emergency Plumbing & Water Heater Repair"
  description="Need a trusted plumber in Denton, TX? 24/7 rapid dispatch for water heater repair, clogged drains, slab leaks & emergency plumbing. Licensed & insured. Call (940) 310-4499."
  faqs={faqs}
>
  <!-- Live Dispatch Top Ticker -->
  <DentonLiveTicker />

  <!-- Hyper-Local Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-brand-950 to-slate-900 text-white py-12 lg:py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Hero Text & Triggers -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 bg-emergency-600/90 text-white text-xs uppercase font-black tracking-widest px-3.5 py-1.5 rounded-full mb-5 shadow-lg">
          <span class="w-2.5 h-2.5 rounded-full bg-white animate-pulse-live"></span>
          <span>Denton County Live Emergency Dispatch</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-6 text-white">
          Expert Plumbing Services in <span class="text-brand-400">Denton, TX</span>
        </h1>

        <p class="text-base sm:text-xl text-slate-300 mb-8 leading-relaxed max-w-2xl">
          Fast, licensed, and transparent plumbing repairs engineered for Denton homes. Specializing in Lake Lewisville hard water scale prevention, expansive clay slab leaks, and 24/7 emergency pipe repairs.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-emergency-600 hover:bg-emergency-500 text-white font-black text-lg shadow-xl transition transform hover:-translate-y-0.5"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            <span>Call {siteConfig.phone}</span>
          </a>

          <a
            href="#neighborhoods"
            class="flex items-center justify-center px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base backdrop-blur-sm border border-white/20 transition"
          >
            <span>View Neighborhood ETAs ↓</span>
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs sm:text-sm text-slate-300">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> 28-35 Min Avg Arrival
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> 100% Upfront Pricing
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> TX Licensed RMP #M-42918
          </div>
        </div>
      </div>

      <!-- Right Form -->
      <div class="lg:col-span-5">
        <LeadForm formTitle="Schedule Fast Denton Service" />
      </div>

    </div>
  </section>

  <TrustBadges />

  <!-- Recent Real Dispatches Feed -->
  <RecentDispatches />

  <!-- Services Grid Section -->
  <section id="services" class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Core Services</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-2">
          Specialized Plumbing Services in Denton, TX
        </h2>
        <p class="text-slate-600 mt-3 text-base">
          Every Denton home faces unique plumbing challenges due to local mineral hardness and soil shifting. Select your service below:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:shadow-md hover:border-brand-500 transition group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl p-3 bg-brand-50 rounded-xl group-hover:scale-110 transition transform">
                  {service.icon}
                </span>
                <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-brand-100 text-brand-800">
                  {service.badge}
                </span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition mb-2">
                <a href={`/denton-tx/${service.slug}/`}>
                  {service.title}
                </a>
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-6">
                {service.desc}
              </p>
            </div>
            
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/denton-tx/${service.slug}/`}
                class="text-sm font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1 group-hover:translate-x-1 transition transform"
              >
                <span>View Denton Service</span>
                <span>→</span>
              </a>
              <a
                href={`tel:${siteConfig.phoneRaw}`}
                class="text-xs font-bold text-emergency-600 hover:underline"
              >
                📞 Call Now
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Hard Water & Clay Soil Geological Diagnostics -->
  <LocalWaterSoilWidget />

  <!-- Hyper-Local Neighborhood Explorer Grid -->
  <div id="neighborhoods">
    <NeighborhoodExplorer />
  </div>

  <!-- Customer Proof / Reviews with Specific Denton Streets -->
  <section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Local Verified Reputation</span>
        <h2 class="text-3xl font-black text-slate-900 mt-1">What Denton Homeowners Say</h2>
        <p class="text-sm text-slate-600 mt-2">Authentic reviews from verified Denton County neighborhoods</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {reviews.map((r) => (
          <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex text-amber-400 mb-3">
                {Array.from({ length: r.rating }).map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <p class="text-sm text-slate-700 italic mb-4 leading-relaxed">
                "{r.text}"
              </p>
            </div>
            <div class="pt-3 border-t border-slate-200">
              <span class="block font-bold text-slate-900 text-sm">{r.name}</span>
              <span class="block text-xs font-semibold text-slate-700">{r.street}</span>
              <span class="block text-xs text-slate-500">{r.city}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Surrounding Tier-2 Areas Section -->
  <section class="py-12 bg-slate-100 px-4 sm:px-6 lg:px-8 border-t border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-8">
        <h3 class="text-xl font-bold text-slate-900">Also Serving Surrounding Denton County Municipalities</h3>
        <p class="text-xs text-slate-500 mt-1">Direct dispatch available 24 hours a day to neighboring towns:</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {siteConfig.serviceAreas.map((area) => (
          <a
            href={`/service-areas/${area.slug}/`}
            class="p-4 rounded-xl bg-white border border-slate-200 hover:border-brand-500 hover:bg-brand-50/50 transition text-center group shadow-sm"
          >
            <span class="block font-bold text-slate-900 group-hover:text-brand-600 text-sm sm:text-base">
              {area.name}, TX
            </span>
            <span class="block text-xs text-slate-500 mt-0.5">
              ZIP {area.zip} • {area.distance}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <FaqAccordion faqs={faqs} />

  <!-- Final Call CTA -->
  <CallToAction />
</BaseLayout>
