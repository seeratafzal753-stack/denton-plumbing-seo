---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CallToAction from '../components/CallToAction.astro';
import { siteConfig } from '../siteConfig';

const services = [
  {
    title: 'Water Heater Repair & Replacement',
    slug: 'water-heater-repair',
    desc: 'Fast diagnosis and replacement for leaking tanks, pilot outages, and hard-water mineral buildup. Gas, electric & hybrid units.',
    icon: '🔥',
    badge: 'Popular',
  },
  {
    title: '24/7 Emergency Plumbing',
    slug: 'emergency-plumbing',
    desc: 'Burst pipes, overflowing toilets, major water leaks, and sudden failures. Rapid 30–45 minute local dispatch.',
    icon: '⚡',
    badge: '24/7 Live',
  },
  {
    title: 'Drain Cleaning & Hydro Jetting',
    slug: 'drain-cleaning',
    desc: 'Clear severe kitchen, bathroom, and main sewer clogs with high-pressure hydro jetting and fiber-optic video camera inspection.',
    icon: '🚿',
    badge: 'Same-Day',
  },
  {
    title: 'Slab Leak Detection & Repair',
    slug: 'slab-leak-repair',
    desc: 'North Texas clay soil causes foundation shifts and underground pipe breaks. Non-invasive electronic leak detection.',
    icon: '🏠',
    badge: 'Specialist',
  },
  {
    title: 'Tankless Water Heater Installation',
    slug: 'tankless-water-heaters',
    desc: 'Endless hot water on demand with 40% lower energy bills. Authorized installers of Navien, Rinnai, and Rheem.',
    icon: '⚡',
    badge: 'Eco-Friendly',
  },
  {
    title: 'Sewer Line Repair & Replacement',
    slug: 'sewer-line-repair',
    desc: 'Trenchless sewer line repairs and pipe lining to eliminate tree root intrusions and collapsed clay lines.',
    icon: '🛠️',
    badge: 'Trenchless',
  },
];

const faqs = [
  {
    question: "How fast can an emergency plumber arrive at my Denton home?",
    answer: "Our technicians are stationed locally throughout Denton County near I-35E, I-35W, and Loop 288. In emergency situations, our average response time is between 30 to 45 minutes."
  },
  {
    question: "Why do water heaters fail frequently in Denton, TX?",
    answer: "Denton's municipal water supply contains moderate-to-high levels of calcium and magnesium (hard water). Without regular annual tank flushing, these minerals settle at the bottom of your water heater, causing corrosion, heating element failure, and tank ruptures."
  },
  {
    question: "What causes slab leaks in North Texas homes?",
    answer: "The Denton and DFW area is built on expansive black clay soil. During hot Texas summers and sudden heavy rains, the soil expands and contracts dramatically, putting immense pressure on concrete foundations and cracking sub-slab copper and PVC water lines."
  },
  {
    question: "Do you offer upfront pricing before work begins?",
    answer: "Yes, 100%. Our Texas licensed plumbers provide a comprehensive inspection and a transparent, upfront written quote before touching a single tool. You will never encounter hidden fees or unexpected overtime charges."
  },
  {
    question: "Which areas and ZIP codes do you serve in Denton County?",
    answer: "We serve all Denton ZIP codes including 76201, 76205, 76207, 76208, 76209, 76210, and 76226, plus surrounding towns like Corinth, Argyle, Lake Dallas, Sanger, and Little Elm."
  }
];

const reviews = [
  {
    name: "Marcus T.",
    area: "Southridge, Denton TX",
    rating: 5,
    text: "Water heater started leaking at 8 PM on a Sunday. Called Denton Plumbing Pros and a technician arrived in 35 minutes! Upfront quote, replaced the relief valve on the spot. Lifesaver!",
  },
  {
    name: "Sarah K.",
    area: "Idiots Hill, Denton TX",
    rating: 5,
    text: "Had a stubborn main drain clog that other plumbers couldn't clear. Their team ran a camera, showed me the tree root invasion, and cleared it with hydro jetting in under an hour.",
  },
  {
    name: "David R.",
    area: "Rayzor Ranch, Denton TX",
    rating: 5,
    text: "Suspected a slab leak due to high water bills. Their electronic detection pin-pointed the exact pipe under our foundation without tearing up unnecessary flooring. Outstanding master plumber.",
  }
];
---

<BaseLayout
  title="Plumber Denton TX | 24/7 Emergency Plumbing & Water Heater Repair"
  description="Need a trusted plumber in Denton, TX? 24/7 rapid dispatch for water heater repair, clogged drains, slab leaks & emergency plumbing. Licensed & insured. Call (940) 310-4499."
  faqs={faqs}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-brand-950 to-slate-900 text-white py-12 lg:py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Hero Text & Triggers -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 bg-emergency-600/90 text-white text-xs uppercase font-bold tracking-widest px-3.5 py-1.5 rounded-full mb-5 shadow-lg">
          <span class="w-2.5 h-2.5 rounded-full bg-white animate-pulse-live"></span>
          <span>Denton's #1 Emergency Plumbing Dispatch</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-6 text-white">
          Expert Plumbing Services in <span class="text-brand-400">Denton, TX</span>
        </h1>

        <p class="text-base sm:text-xl text-slate-300 mb-8 leading-relaxed max-w-2xl">
          Fast, licensed, and transparent plumbing repairs for homeowners and businesses across Denton County. From leaking water heaters to emergency slab leaks—we are on standby 24/7.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-emergency-600 hover:bg-emergency-500 text-white font-black text-lg shadow-xl transition transform hover:-translate-y-0.5"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            <span>Call {siteConfig.phone}</span>
          </a>

          <a
            href="#services"
            class="flex items-center justify-center px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base backdrop-blur-sm border border-white/20 transition"
          >
            <span>Explore Services ↓</span>
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs sm:text-sm text-slate-300">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> 30-45 Min Avg Arrival
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> Upfront Pricing
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span> Texas Licensed RMP
          </div>
        </div>
      </div>

      <!-- Right Form -->
      <div class="lg:col-span-5">
        <LeadForm formTitle="Schedule Fast Denton Service" />
      </div>

    </div>
  </section>

  <TrustBadges />

  <!-- Services Grid Section -->
  <section id="services" class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Core Capabilities</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-2">
          Specialized Plumbing Services in Denton, TX
        </h2>
        <p class="text-slate-600 mt-3 text-base">
          Every home in Denton faces unique plumbing demands due to local water hardness and soil movement. Our licensed technicians provide long-lasting repairs.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:shadow-md hover:border-brand-500 transition group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl p-3 bg-brand-50 rounded-xl group-hover:scale-110 transition transform">
                  {service.icon}
                </span>
                <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-brand-100 text-brand-800">
                  {service.badge}
                </span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition mb-2">
                <a href={`/denton-tx/${service.slug}/`}>
                  {service.title}
                </a>
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-6">
                {service.desc}
              </p>
            </div>
            
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/denton-tx/${service.slug}/`}
                class="text-sm font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1 group-hover:translate-x-1 transition transform"
              >
                <span>View Denton Service</span>
                <span>→</span>
              </a>
              <a
                href={`tel:${siteConfig.phoneRaw}`}
                class="text-xs font-bold text-emergency-600 hover:underline"
              >
                📞 Call Now
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Local Geographic Context & Soil/Hard Water Impact -->
  <section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Local Denton Knowledge</span>
        <h2 class="text-3xl font-black text-slate-900 mt-2 mb-4 leading-tight">
          Why Denton, Texas Homes Require Specialized Plumbing Care
        </h2>
        <div class="space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed">
          <p>
            <strong>1. North Texas Expansive Black Clay Soil:</strong> Denton sits on highly active clay soils that swell when saturated and shrink drastically during dry Texas heatwaves. This shifting causes immense structural torque on underground water and sewer mains, resulting in hidden <em>slab leaks</em>.
          </p>
          <p>
            <strong>2. Hard Water Mineral Scale:</strong> Sourced from Lake Lewisville and Ray Roberts, municipal tap water has notable mineral hardness. Over 3–5 years, mineral scale accumulates in traditional tank water heaters, reducing heating efficiency by up to 30% and causing bottom tank corrosion.
          </p>
          <p>
            <strong>3. Aging Historic Lines vs Modern Subdivisions:</strong> From historic cast-iron lines in neighborhoods near Idiots Hill and Downtown Square to modern PEX piping in Rayzor Ranch, our certified technicians understand the distinct construction eras across Denton.
          </p>
        </div>

        <div class="mt-6 p-4 rounded-xl bg-brand-50 border border-brand-200 text-brand-900 text-xs sm:text-sm font-medium flex items-center gap-3">
          <span class="text-2xl">💡</span>
          <span>We provide camera video inspections and acoustic leak detection for accurate, non-invasive diagnosis.</span>
        </div>
      </div>

      <div class="bg-slate-900 text-white p-8 rounded-2xl shadow-xl">
        <h3 class="text-xl font-bold text-white mb-4">
          Neighborhoods We Serve in Denton, TX
        </h3>
        <p class="text-xs text-slate-300 mb-6">
          Our fully-stocked mobile trucks provide fast response to every neighborhood in the City of Denton:
        </p>

        <div class="grid grid-cols-2 gap-3 mb-6 text-xs">
          {siteConfig.neighborhoods.map((n) => (
            <div class="flex items-center gap-2 text-slate-200 bg-slate-800/80 p-2 rounded-lg border border-slate-700">
              <span class="text-brand-400">📍</span> {n}
            </div>
          ))}
        </div>

        <div class="border-t border-slate-800 pt-4 text-xs text-slate-400">
          <strong class="text-white">Covered ZIP Codes:</strong> {siteConfig.zipCodes.join(', ')}
        </div>
      </div>

    </div>
  </section>

  <!-- Customer Proof / Reviews -->
  <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8 border-t border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Local Reputation</span>
        <h2 class="text-3xl font-black text-slate-900 mt-1">What Denton Homeowners Say</h2>
        <p class="text-sm text-slate-600 mt-2">Verified reviews from your Denton neighbors</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {reviews.map((r) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex text-amber-400 mb-3">
                {Array.from({ length: r.rating }).map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <p class="text-sm text-slate-700 italic mb-4 leading-relaxed">
                "{r.text}"
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100">
              <span class="block font-bold text-slate-900 text-sm">{r.name}</span>
              <span class="block text-xs text-slate-500">{r.area}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Surrounding Tier-2 Areas Section -->
  <section class="py-12 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-8">
        <h3 class="text-xl font-bold text-slate-900">Also Serving Surrounding Denton County Communities</h3>
        <p class="text-xs text-slate-500 mt-1">Direct dispatch available 24 hours a day to all neighboring towns:</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {siteConfig.serviceAreas.map((area) => (
          <a
            href={`/service-areas/${area.slug}/`}
            class="p-4 rounded-xl border border-slate-200 hover:border-brand-500 hover:bg-brand-50/50 transition text-center group"
          >
            <span class="block font-bold text-slate-900 group-hover:text-brand-600 text-sm sm:text-base">
              {area.name}, TX
            </span>
            <span class="block text-xs text-slate-500 mt-0.5">
              ZIP {area.zip} • {area.distance}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <FaqAccordion faqs={faqs} />

  <!-- Final Call CTA -->
  <CallToAction />
</BaseLayout>
