---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlumberMascotHero from '../components/PlumberMascotHero.astro';
import HeroTrustBar from '../components/HeroTrustBar.astro';
import ReviewCardsClean from '../components/ReviewCardsClean.astro';
import ThreeStepProcess from '../components/ThreeStepProcess.astro';
import LocalWaterSoilWidget from '../components/LocalWaterSoilWidget.astro';
import NeighborhoodExplorer from '../components/NeighborhoodExplorer.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../siteConfig';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const faqs = [
  {
    question: "What plumbing services can I find through your Denton network?",
    answer: "We connect homeowners and businesses across Denton County with independent local plumbing specialists for water heater repair and replacement (tank and tankless), non-invasive slab leak detection, emergency drain cleaning with hydro-jetting, whole-house PEX repiping, sewer line video inspections, and urgent emergency repairs."
  },
  {
    question: "How does this referral service work?",
    answer: "When you call our hotline or submit an online request, our dispatch desk routes your details to independent, pre-screened local plumbing contractors stationed in or near your Denton ZIP code. The contractor contacts you promptly to provide estimates and schedule service."
  },
  {
    question: "Is using this referral service free for homeowners?",
    answer: "Yes, 100% free. There are no fees or obligations to use our matching platform. You only pay the independent contractor you choose to hire for the actual plumbing repair or installation work performed."
  },
  {
    question: "Do participating contractors provide upfront pricing?",
    answer: "Yes. Participating independent contractors evaluate your specific plumbing issue and present transparent, upfront estimates before beginning work, so you know the cost without hidden surprise fees."
  },
  {
    question: "Why do Denton homes frequently experience slab leaks and water heater scale?",
    answer: "Denton sits on expansive black clay soil (high plasticity index) that expands and contracts during seasonal temperature swings, stressing underground foundation pipes. Additionally, Denton tap water contains high mineral hardness (8.8 GPG), which bakes mineral scale onto water heater elements if not regularly serviced."
  }
];
---

<BaseLayout
  title="Plumber Denton TX | Fast Local Plumbing Connection & Estimates"
  description="Connect with reliable local plumbers in Denton, TX. 24/7 emergency plumbing referral, water heaters, drain cleaning, and slab leak solutions. Call (940) 310-4499."
  faqs={faqs}
>

  <!-- ========================================================= -->
  <!-- 1. HERO SECTION (Lead Gen Referral & Matching Focus) -->
  <!-- ========================================================= -->
  <section class="bg-gradient-to-b from-sky-50/40 via-white to-slate-50/30 border-b border-slate-200 py-6 sm:py-8 lg:py-10 px-4 sm:px-6 lg:px-8 overflow-hidden relative">
    
    <!-- Subtle Background Grid Accent -->
    <div class="absolute inset-0 bg-[radial-gradient(#e0f2fe_1px,transparent_1px)] [background-size:24px_24px] opacity-60 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
      
      <!-- LEFT SIDE: Location Badge, Balanced Heading, Trust Row, CTAs & Features -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-4 sm:space-y-5">
        
        <!-- Small Location / Trust Badge -->
        <div class="inline-flex items-center gap-2 bg-slate-100/90 text-slate-800 border border-slate-200 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider shadow-sm">
          <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
          <span>Denton County Plumbing Referral Network</span>
        </div>

        <!-- Balanced Heading -->
        <h1 class="text-2xl sm:text-4xl lg:text-4xl 2xl:text-5xl font-extrabold tracking-tight leading-snug sm:leading-[1.18] text-slate-900 font-serif">
          <span>Find Trusted Local Plumbers in Denton, TX</span>
          <span class="text-red-600 block mt-1 font-black">Fast Connection When You Need Help</span>
        </h1>

        <!-- Concise Supporting Copy -->
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl mx-auto lg:mx-0 font-normal">
          We connect homeowners with reputable, independent local plumbing specialists in Denton, TX. From emergency water heater leaks and clogged mainlines to non-invasive slab leak detection, get fast contractor matches and upfront quotes.
        </p>

        <!-- Value Points Row with Clean Vector Icons and Dividers -->
        <div class="inline-flex flex-wrap items-center justify-center lg:justify-start gap-2.5 sm:gap-3 bg-slate-50 border border-slate-200/90 rounded-2xl px-4 py-2 shadow-sm text-xs">
          <div class="flex items-center gap-1.5 text-slate-800 font-bold">
            <Icon name="bolt" class="w-3.5 h-3.5 text-red-600" />
            <span>Fast Local Dispatch</span>
          </div>
          <span class="text-slate-400 font-black text-xs leading-none">•</span>
          <span class="text-slate-700 font-semibold flex items-center gap-1.5">
            <Icon name="map-pin" class="w-3.5 h-3.5 text-brand-600" />
            <span>Denton County Coverage</span>
          </span>
          <span class="text-slate-400 font-black text-xs leading-none">•</span>
          <span class="text-emerald-700 font-extrabold flex items-center gap-1">
            <Icon name="shield-check" class="w-3.5 h-3.5 text-emerald-600" />
            <span>100% Free Referral Service</span>
          </span>
        </div>

        <!-- Strong Above-The-Fold CTA Buttons (min 52px height) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-1">
          
          <!-- Primary CTA: CALL NOW (Red, High-Impact) -->
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="w-full sm:w-auto min-h-[52px] sm:min-h-[56px] px-7 py-3.5 rounded-2xl bg-red-600 hover:bg-red-700 active:bg-red-800 text-white font-black text-base uppercase tracking-wider shadow-xl shadow-red-600/25 hover:shadow-2xl hover:shadow-red-600/35 transition-all duration-200 ease-out transform hover:-translate-y-0.5 active:translate-y-0.5 flex items-center justify-center gap-2.5 text-center group cursor-pointer"
          >
            <Icon name="phone" class="w-5 h-5 text-white group-hover:scale-110 transition-transform" />
            <span>CALL HOTLINE: {siteConfig.phone}</span>
          </a>

          <!-- Secondary CTA: GET AN ESTIMATE (Dark Slate) -->
          <a
            href="#estimate-form"
            class="w-full sm:w-auto min-h-[52px] sm:min-h-[56px] px-7 py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-950 active:bg-black text-white font-black text-base uppercase tracking-wider shadow-md hover:shadow-lg transition-all duration-200 ease-out transform hover:-translate-y-0.5 active:translate-y-0.5 flex items-center justify-center gap-2.5 text-center cursor-pointer"
          >
            <Icon name="calendar" class="w-5 h-5 text-slate-300" />
            <span>GET AN ESTIMATE</span>
          </a>

        </div>

      </div>

      <!-- RIGHT SIDE: Plumber Photo Card -->
      <div class="lg:col-span-5 flex justify-center">
        <PlumberMascotHero />
      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 2. DEDICATED FULL-WIDTH TRUST BAR STRIP -->
  <!-- ========================================================= -->
  <HeroTrustBar />

  <!-- ========================================================= -->
  <!-- 3. "WHAT YOUR NEIGHBORS ARE SAYING" (Social Proof Cards) -->
  <!-- ========================================================= -->
  <ReviewCardsClean />

  <!-- ========================================================= -->
  <!-- 4. WATER HEATER SERVICES IN DENTON -->
  <!-- ========================================================= -->
  <section id="water-heaters" class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Graphic Card (Water Heater Photo with Clean Presentation) -->
      <div class="lg:col-span-5 order-1 lg:order-1">
        <div class="relative rounded-3xl overflow-hidden shadow-xl border border-slate-200 bg-white group">
          <img
            src="/images/rheem-water-heater.jpg"
            alt="Water Heater Installation and Repair in Denton TX"
            class="w-full h-auto max-h-[380px] object-cover object-center group-hover:scale-[1.02] transition-transform duration-500"
            width="800"
            height="600"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/85 via-slate-900/40 to-transparent p-4 text-white">
            <span class="block text-xs font-black text-white">Water Heater Solutions</span>
            <span class="block text-[11px] text-slate-300">Repair • Installation • Replacement</span>
          </div>
        </div>
      </div>

      <!-- Right Editorial -->
      <div class="lg:col-span-7 order-2 lg:order-2 space-y-4">
        <div class="inline-flex items-center gap-2 bg-red-50 text-red-700 border border-red-200 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider">
          <Icon name="flame" class="w-3.5 h-3.5 text-red-600" />
          <span>WATER HEATER SERVICES IN DENTON</span>
        </div>
        
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif tracking-tight leading-tight">
          Water Heater Repair &amp; Replacement in Denton, TX
        </h2>

        <p class="text-slate-700 text-base sm:text-lg leading-relaxed font-normal">
          Need reliable hot water for your Denton home? Get professional water heater service for common problems, repairs, replacements, and new installations. Whether your water heater is leaking, not heating properly, or ready for an upgrade, get help choosing the right solution for your home.
        </p>

        <ul class="space-y-2.5 text-sm sm:text-base text-slate-800 font-medium">
          <li class="flex items-center gap-2.5">
            <Icon name="check" class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
            <span>Water heater repair &amp; troubleshooting</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="check" class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
            <span>Tank and tankless water heater installation</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="check" class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
            <span>Water heater replacement &amp; upgrades</span>
          </li>
        </ul>

        <div class="pt-2">
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-2xl bg-red-600 hover:bg-red-700 active:bg-red-800 text-white font-black text-sm sm:text-base uppercase tracking-wider shadow-lg shadow-red-600/20 hover:shadow-xl hover:shadow-red-600/30 transition-all duration-200 ease-out transform hover:-translate-y-0.5 active:translate-y-0"
          >
            <Icon name="phone" class="w-4 h-4 text-white" />
            <span>CALL FOR WATER HEATER SERVICE: {siteConfig.phone}</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 5. 3-STEP PROCESS (How Referral Works) -->
  <!-- ========================================================= -->
  <ThreeStepProcess />

  <!-- ========================================================= -->
  <!-- 6. LOCAL PLUMBER CONNECTION SECTION -->
  <!-- ========================================================= -->
  <section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Editorial -->
      <div class="lg:col-span-7 space-y-4">
        <div class="inline-flex items-center gap-2 bg-slate-100 text-slate-800 border border-slate-300 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider">
          <Icon name="shield-check" class="w-3.5 h-3.5 text-brand-600" />
          <span>LOCAL PLUMBING CONNECTION • DENTON, TX</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif tracking-tight">
          Connect With a Local Plumber in Denton, TX
        </h2>
        <p class="text-slate-700 text-base sm:text-lg leading-relaxed font-normal">
          We help Denton-area homeowners connect with local plumbing professionals for repairs, replacements, and installation projects.
        </p>
        <p class="text-slate-700 text-base sm:text-lg leading-relaxed font-normal">
          Tell us what you need, and we'll help connect you with a plumbing professional who can discuss your options.
        </p>
        <div class="pt-3">
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-2xl bg-red-600 hover:bg-red-700 active:bg-red-800 text-white font-black text-sm sm:text-base uppercase tracking-wider shadow-lg shadow-red-600/20 hover:shadow-xl hover:shadow-red-600/30 transition-all duration-200 ease-out transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
          >
            <Icon name="phone" class="w-4 h-4 text-white" />
            <span>CONNECT WITH A LOCAL PLUMBER — {siteConfig.phone}</span>
          </a>
        </div>
      </div>

      <!-- Right Graphic (Clean Manifold & Pressure Gauge Photo without plaques/certificates) -->
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl overflow-hidden shadow-xl border border-slate-200 bg-white group">
          <img
            src="/images/plumbing-workmanship.jpg"
            alt="Professional Residential Plumbing System Installation in Denton TX"
            class="w-full h-auto max-h-[380px] object-cover object-center group-hover:scale-[1.02] transition-transform duration-500"
            width="800"
            height="600"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/85 via-slate-900/40 to-transparent p-4 text-white">
            <span class="block text-xs font-black text-white">Professional Plumbing Solutions</span>
            <span class="block text-[11px] text-slate-300">Local Plumbing Professionals • Denton, TX</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 7. SECTION: WATER HEATER SOLUTIONS -->
  <!-- ========================================================= -->
  <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Equipment Photo Card -->
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-300 bg-white group">
          
          <!-- High-Res Photo -->
          <img
            src="/images/smart-water-heater.jpg"
            alt="Smart Tankless Water Heater and Digital Leak Detection System in Denton TX"
            class="w-full h-auto max-h-[400px] object-cover object-center group-hover:scale-[1.02] transition-transform duration-500"
            width="800"
            height="600"
            loading="lazy"
          />

          <!-- Gradient Overlay -->
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/90 via-slate-900/50 to-transparent p-5 text-white">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-black text-white flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                <span>Water Heater Specialists</span>
              </span>
              <span class="px-2.5 py-0.5 rounded-full bg-white/20 border border-white/30 text-[10px] font-black uppercase text-white">
                Tank &amp; Tankless
              </span>
            </div>
            <span class="text-[11px] text-slate-300 block">
              Professional Installation, Repair &amp; Maintenance in Denton, TX
            </span>
          </div>

        </div>
      </div>

      <!-- Right Editorial with Direct Water Heater Focus -->
      <div class="lg:col-span-7 order-1 lg:order-2 space-y-5">
        
        <!-- Chhota Badge -->
        <div class="inline-flex items-center gap-2 bg-red-50 text-red-700 border border-red-200 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider">
          <Icon name="bolt" class="w-3.5 h-3.5 text-red-600" />
          <span>WATER HEATER INSTALLATION &amp; PROTECTION</span>
        </div>

        <!-- Heading -->
        <h2 class="text-3xl sm:text-4xl lg:text-4xl font-extrabold text-slate-900 font-serif tracking-tight leading-tight">
          Smart Water Heater Solutions in Denton
        </h2>

        <!-- Natural Paragraph -->
        <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
          Get reliable water heater solutions for your Denton home, including installation, replacement, repairs, and modern energy-efficient options. Our team can help you choose the right system for your home's hot-water needs.
        </p>

        <!-- Clean Bullets -->
        <ul class="space-y-2.5 text-sm sm:text-base text-slate-800 font-medium">
          <li class="flex items-center gap-2.5">
            <Icon name="check" class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
            <span>Water heater repair &amp; troubleshooting</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="check" class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
            <span>Tank and tankless water heater installation</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="check" class="w-4 h-4 text-emerald-600 font-bold shrink-0" />
            <span>Water heater replacement &amp; upgrades</span>
          </li>
        </ul>

        <!-- Direct Rank & Rent CTA Button -->
        <div class="pt-3">
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-red-600 hover:bg-red-700 active:bg-red-800 text-white font-black text-base uppercase tracking-wider shadow-xl shadow-red-600/25 hover:shadow-2xl hover:shadow-red-600/35 transition-all duration-200 ease-out transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
          >
            <Icon name="phone" class="w-5 h-5 text-white" />
            <span>CALL FOR WATER HEATER SERVICE: {siteConfig.phone}</span>
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 8. HARD WATER & CLAY SOIL GEOLOGICAL DIAGNOSTICS -->
  <!-- ========================================================= -->
  <LocalWaterSoilWidget />

  <!-- ========================================================= -->
  <!-- 9. NEIGHBORHOOD EXPLORER GRID -->
  <!-- ========================================================= -->
  <div id="neighborhoods">
    <NeighborhoodExplorer />
  </div>

  <!-- ========================================================= -->
  <!-- 10. PLUMBING SERVICE REQUEST FORM -->
  <!-- ========================================================= -->
  <section id="estimate-form" class="py-16 bg-slate-900 text-white px-4 sm:px-6 lg:px-8 border-t border-slate-800">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-black uppercase tracking-widest text-brand-400 block mb-1">
          GET CONNECTED WITH A LOCAL PLUMBING PROFESSIONAL
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight font-serif">
          NEED A PLUMBER IN DENTON?
        </h2>
        <p class="text-slate-400 text-sm mt-2 max-w-xl mx-auto">
          Tell us what you need and we'll help connect you with a local plumbing professional.
        </p>
      </div>
      <LeadForm formTitle="Need a Plumber in Denton?" />
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 11. LATEST PLUMBING & HOMEOWNER GUIDES (BLOGS) -->
  <!-- ========================================================= -->
  <section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200">
    <div class="max-w-6xl mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-brand-700 block mb-1">
            Homeowner Knowledge Base &amp; Tips
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif tracking-tight">
            Latest Denton Plumbing Guides
          </h2>
          <p class="text-slate-600 text-sm mt-1">
            Practical insights and preventive maintenance advice for North Texas homeowners.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href="/blog/"
            class="inline-flex items-center gap-2 text-sm font-bold text-brand-700 hover:text-brand-800 hover:underline"
          >
            <span>View All Guides</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-500 transition flex flex-col justify-between group">
            <div class="p-6">
              <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
                <span class="bg-white border border-slate-200 text-brand-800 font-bold px-2.5 py-0.5 rounded-full uppercase text-[10px]">
                  {post.data.category}
                </span>
                <span>
                  {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(post.data.pubDate)}
                </span>
              </div>
              <h3 class="font-bold text-slate-900 text-base group-hover:text-brand-700 transition font-serif leading-snug mb-2">
                <a href={`/blog/${post.slug}/`}>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="px-6 py-3.5 bg-white border-t border-slate-200 flex items-center justify-between text-xs">
              <span class="text-slate-500">By {post.data.author}</span>
              <a href={`/blog/${post.slug}/`} class="font-bold text-brand-700 group-hover:translate-x-1 transition transform flex items-center gap-1">
                <span>Read Article</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 12. CLEAN FAQS ACCORDION -->
  <!-- ========================================================= -->
  <FaqAccordion faqs={faqs} />

</BaseLayout>
