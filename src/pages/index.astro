---
import BaseLayout from '../layouts/BaseLayout.astro';
import TruckHeroGraphic from '../components/TruckHeroGraphic.astro';
import MascotStorySection from '../components/MascotStorySection.astro';
import ServiceIconsGrid from '../components/ServiceIconsGrid.astro';
import TechnicianVideoSection from '../components/TechnicianVideoSection.astro';
import InteractiveHouseBlueprint from '../components/InteractiveHouseBlueprint.astro';
import FleetSpeedSection from '../components/FleetSpeedSection.astro';
import ReviewBannerRed from '../components/ReviewBannerRed.astro';
import LocalWaterSoilWidget from '../components/LocalWaterSoilWidget.astro';
import NeighborhoodExplorer from '../components/NeighborhoodExplorer.astro';
import LeadForm from '../components/LeadForm.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { siteConfig } from '../siteConfig';

const faqs = [
  {
    question: "How fast can an emergency plumber arrive at my Denton home?",
    answer: "Our technicians are stationed locally throughout Denton County near I-35E, I-35W, and Loop 288. In emergency situations, our average response time is between 28 to 35 minutes."
  },
  {
    question: "Why do water heaters fail frequently in Denton, TX?",
    answer: "Denton's municipal water supply (sourced from Lake Lewisville & Lake Ray Roberts) contains high levels of calcium and magnesium (8.8 GPG hardness rating). Without regular annual flushing, these minerals settle at the bottom of your water heater, causing bottom tank corrosion, element burnout, and ruptures."
  },
  {
    question: "What causes slab leaks in North Texas homes?",
    answer: "Denton is built on expansive black clay soil with a high plasticity index. During hot Texas summers and sudden heavy rains, the soil expands and contracts dramatically, putting immense pressure on concrete foundations and cracking sub-slab copper and PVC water lines."
  },
  {
    question: "Do you offer upfront pricing before work begins?",
    answer: "Yes, 100%. Our Texas licensed master plumbers provide a comprehensive inspection and a transparent, upfront written quote before touching a single tool. You will never encounter hidden fees or unexpected overtime charges."
  },
  {
    question: "Which areas and ZIP codes do you serve in Denton County?",
    answer: "We serve all Denton ZIP codes including 76201, 76205, 76207, 76208, 76209, 76210, and 76226, plus surrounding towns like Corinth, Argyle, Lake Dallas, Sanger, and Little Elm."
  }
];
---

<BaseLayout
  title="Plumber Denton TX | 24/7 Emergency Plumbing & Water Heater Repair"
  description="Your trusted local expert plumber in Denton, TX & surrounding areas. 24/7 rapid dispatch for water heaters, clogged drains, slab leaks & emergency plumbing. Call (940) 310-4499."
  faqs={faqs}
>
  
  <!-- 1. HERO SECTION (Dark Cinematic Background with Truck Graphic & High-Impact Pitch) -->
  <section class="bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white py-12 lg:py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden border-b border-slate-800">
    
    <!-- Background Texture -->
    <div class="absolute inset-0 bg-[radial-gradient(#1e3a8a_1px,transparent_1px)] [background-size:24px_24px] opacity-20 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
      
      <!-- Left Hero Pitch -->
      <div class="lg:col-span-6 text-center lg:text-left">
        
        <!-- Red/White Pill Badge -->
        <div class="inline-flex items-center gap-2 bg-emergency-600 text-white text-xs uppercase font-black tracking-wider px-3.5 py-1.5 rounded-full mb-4 shadow-lg">
          <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
          <span>YOUR LOCAL EXPERT PLUMBER</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-4 text-white uppercase">
          IN DENTON & <br />
          <span class="text-emergency-500">SURROUNDING AREA</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0">
          Fast, licensed, and transparent plumbing solutions engineered for North Texas homes. From emergency pipe bursts to tankless water heaters and slab leak repairs.
        </p>

        <!-- Red CTA Button Matching Reference -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="w-full sm:w-auto px-8 py-4 rounded-full bg-emergency-600 hover:bg-emergency-700 text-white font-black text-base uppercase tracking-wider shadow-2xl transition transform hover:-translate-y-0.5 text-center flex items-center justify-center gap-2"
          >
            <span>📞</span>
            <span>SCHEDULE A FAST DISPATCH</span>
          </a>

          <a
            href="#estimate-form"
            class="w-full sm:w-auto px-6 py-4 rounded-full bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm uppercase tracking-wider transition text-center"
          >
            Get Free Quote ↓
          </a>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
          <span>✓ 28 Min Avg. Arrival</span>
          <span>•</span>
          <span>✓ 100% Upfront Pricing</span>
          <span>•</span>
          <span>✓ Master Plumber #M-42918</span>
        </div>

      </div>

      <!-- Right Service Van Graphic -->
      <div class="lg:col-span-6">
        <TruckHeroGraphic />
      </div>

    </div>
  </section>

  <!-- 2. BRAND STORY & MASCOT SECTION (Pride in Plumbing Solutions) -->
  <MascotStorySection />

  <!-- 3. 10-ICON SERVICE MATRIX GRID (Professional Plumbing Services in Denton) -->
  <ServiceIconsGrid />

  <!-- 4. VIDEO / TECHNICIAN SHOWCASE SECTION (Meet Your Local Team) -->
  <TechnicianVideoSection />

  <!-- 5. INTERACTIVE 3D HOUSE BLUEPRINT / FLOORPLAN (Where Are Your Plumbing Problems?) -->
  <InteractiveHouseBlueprint />

  <!-- 6. FLEET SPEED / RESPONSE SECTION (Denton Rapid Dispatch 911 Fleet) -->
  <FleetSpeedSection />

  <!-- 7. RED TESTIMONIAL BANNER / REVIEWS (What Our Awesome Customers Say) -->
  <ReviewBannerRed />

  <!-- 8. HYPER-LOCAL GEOLOGICAL DIAGNOSTICS (Lake Hard Water + North Texas Black Clay) -->
  <LocalWaterSoilWidget />

  <!-- 9. HYPER-LOCAL NEIGHBORHOOD EXPLORER GRID -->
  <div id="neighborhoods">
    <NeighborhoodExplorer />
  </div>

  <!-- 10. FAST ESTIMATE FORM SECTION -->
  <section id="estimate-form" class="py-16 bg-slate-900 text-white px-4 sm:px-6 lg:px-8 border-t border-slate-800">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-black uppercase tracking-widest text-brand-400 block mb-1">
          FAST CALLBACK ESTIMATE
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight">
          REQUEST INSTANT DENTON PLUMBING SERVICE
        </h2>
        <p class="text-slate-400 text-sm mt-2">
          Fill out the brief form below and our on-duty dispatcher will call you within 5 minutes.
        </p>
      </div>
      <LeadForm formTitle="Schedule Fast Denton Service" />
    </div>
  </section>

  <!-- 11. FAQS SECTION -->
  <FaqAccordion faqs={faqs} />

</BaseLayout>
