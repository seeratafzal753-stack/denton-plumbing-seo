---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import CallToAction from '../../components/CallToAction.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../siteConfig';

const locations = await getCollection('locations');

const crumbs = [
  { name: 'Service Areas', item: '/service-areas/' },
];
---

<BaseLayout
  title="Plumbing Service Areas in Denton County | Denton Plumbing Pros"
  description="Explore all cities and communities served by Denton Plumbing Pros throughout Denton County, TX. Rapid 24/7 dispatch across North Texas."
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="py-12 lg:py-16 bg-slate-900 text-white px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-xs uppercase font-bold tracking-widest text-brand-400">Denton County Service Area</span>
      <h1 class="text-3xl sm:text-5xl font-black mt-2 mb-4">
        Communities We Serve Across Denton County
      </h1>
      <p class="text-slate-300 text-base sm:text-lg">
        Fast, licensed, and reliable plumbing dispatch throughout Denton and all surrounding cities and suburbs.
      </p>
    </div>
  </section>

  <TrustBadges />

  <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      
      <!-- Primary City Hub -->
      <div class="mb-12 p-8 rounded-2xl bg-white border-2 border-brand-500 shadow-md">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div>
            <span class="inline-block px-3 py-1 bg-brand-100 text-brand-800 text-xs font-bold uppercase rounded-full mb-2">
              Primary City Hub
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900">
              Denton, TX (All Neighborhoods &amp; ZIPs)
            </h2>
            <p class="text-slate-600 text-sm mt-1">
              ZIP Codes: {siteConfig.zipCodes.join(', ')} • 30-45 Minute Average Dispatch
            </p>
          </div>
          <a
            href="/denton-tx/"
            class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow transition"
          >
            Explore Denton Hub →
          </a>
        </div>
      </div>

      <!-- Surrounding Service Areas -->
      <h3 class="text-xl font-bold text-slate-900 mb-6">Surrounding Municipalities</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {locations.map((loc) => (
          <div class="bg-white p-7 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between hover:border-brand-500 transition">
            <div>
              <span class="text-xs text-brand-600 font-bold uppercase block mb-1">
                {loc.data.county}
              </span>
              <h4 class="text-2xl font-bold text-slate-900 mb-2">
                <a href={`/service-areas/${loc.slug}/`} class="hover:text-brand-600 transition">
                  {loc.data.cityName}, {loc.data.state}
                </a>
              </h4>
              <p class="text-xs text-slate-500 mb-4">
                {loc.data.distanceFromDenton || 'Denton County Service Area'}
              </p>
              <div class="text-xs text-slate-600 space-y-1 mb-4">
                <strong>ZIP Codes:</strong> {loc.data.postalCodes.join(', ')}
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/service-areas/${loc.slug}/`}
                class="text-sm font-bold text-brand-600 hover:text-brand-700"
              >
                View City Details →
              </a>
              <a
                href={`tel:${siteConfig.phoneRaw}`}
                class="text-xs font-bold text-emergency-600 hover:underline flex items-center gap-1"
              >
                <Icon name="phone" class="w-3.5 h-3.5 text-red-600" />
                <span>Dispatch</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <CallToAction />
</BaseLayout>
