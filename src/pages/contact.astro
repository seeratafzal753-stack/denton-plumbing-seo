---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import TrustBadges from '../components/TrustBadges.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';

const crumbs = [
  { name: 'Contact Us', item: '/contact/' },
];
---

<BaseLayout
  title="Contact Us | 24/7 Denton Plumbing Referral Desk"
  description="Contact Denton Plumbing Pros for 24/7 emergency matching, contractor estimates, or plumbing inquiries in Denton, TX. Call (940) 310-4499."
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="py-12 lg:py-16 bg-slate-900 text-white px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-xs uppercase font-bold tracking-widest text-brand-400">Local Referral Network</span>
      <h1 class="text-3xl sm:text-5xl font-black mt-2 mb-4 font-serif">
        Contact Denton Plumbing Pros
      </h1>
      <p class="text-slate-300 text-base sm:text-lg">
        Need emergency service assistance or want to schedule an upcoming plumbing repair? Our local Denton referral desk is available 24/7.
      </p>
    </div>
  </section>

  <TrustBadges />

  <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <div class="lg:col-span-5 space-y-8">
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
          <h2 class="text-2xl font-black text-slate-900 mb-6 font-serif">Referral &amp; Matching Desk</h2>
          
          <div class="space-y-6 text-sm">
            <div>
              <strong class="block text-xs uppercase text-slate-500 font-bold mb-1">24/7 Hotline:</strong>
              <a href={`tel:${siteConfig.phoneRaw}`} class="text-2xl font-black text-emergency-600 hover:underline flex items-center gap-2">
                <Icon name="phone" class="w-6 h-6 text-red-600" />
                <span>{siteConfig.phone}</span>
              </a>
              <p class="text-xs text-slate-500 mt-1">Available 24 Hours / 7 Days a Week</p>
            </div>

            <div>
              <strong class="block text-xs uppercase text-slate-500 font-bold mb-1">Email Inquiries:</strong>
              <a href={`mailto:${siteConfig.email}`} class="text-brand-600 font-medium">
                {siteConfig.email}
              </a>
            </div>

            <div>
              <strong class="block text-xs uppercase text-slate-500 font-bold mb-1">Primary Coverage:</strong>
              <p class="text-slate-800 font-medium flex items-center gap-1.5">
                <Icon name="map-pin" class="w-4 h-4 text-slate-500" />
                <span>Denton, TX {siteConfig.postalCode} (All Denton County ZIPs)</span>
              </p>
            </div>

            <div>
              <strong class="block text-xs uppercase text-slate-500 font-bold mb-1">Service Model:</strong>
              <p class="text-slate-800 font-medium flex items-center gap-1.5">
                <Icon name="shield-check" class="w-4 h-4 text-emerald-600" />
                <span>Free Homeowner Referral &amp; Contractor Matching</span>
              </p>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm">
          <strong class="flex items-center gap-1.5 font-bold mb-1">
            <Icon name="alert" class="w-4 h-4 text-amber-700" />
            <span>For Active Flooding / Burst Pipes:</span>
          </strong>
          <p class="text-xs text-amber-800 mb-3">
            Please immediately turn off your main water shutoff valve (usually near your water meter or inside your garage) and call our referral line directly for priority matching.
          </p>
          <a href={`tel:${siteConfig.phoneRaw}`} class="inline-flex items-center gap-2 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-lg transition">
            <Icon name="phone" class="w-3.5 h-3.5 text-white" />
            <span>Direct Call: {siteConfig.phone}</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <LeadForm formTitle="Send a Service Request" />
      </div>

    </div>
  </section>
</BaseLayout>
