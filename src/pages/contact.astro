---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { siteConfig } from '../siteConfig';

const crumbs = [
  { name: 'Contact Us', item: '/contact/' },
];
---

<BaseLayout
  title="Contact Us | 24/7 Denton Plumbing Dispatch"
  description="Contact Denton Plumbing Pros for 24/7 emergency dispatch, same-day estimates, or general plumbing inquiries in Denton, TX. Call (940) 310-4499."
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="py-12 lg:py-16 bg-slate-900 text-white px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-xs uppercase font-bold tracking-widest text-brand-400">Direct Local Dispatch</span>
      <h1 class="text-3xl sm:text-5xl font-black mt-2 mb-4">
        Contact Denton Plumbing Pros
      </h1>
      <p class="text-slate-300 text-base sm:text-lg">
        Need emergency service or want to schedule an upcoming repair? Our Denton dispatch team is ready 24/7.
      </p>
    </div>
  </section>

  <TrustBadges />

  <section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <div class="lg:col-span-5 space-y-8">
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
          <h2 class="text-2xl font-black text-slate-900 mb-6">Dispatch Information</h2>
          
          <div class="space-y-6 text-sm">
            <div>
              <strong class="block text-xs uppercase text-slate-500 font-bold mb-1">Emergency Dispatch Phone:</strong>
              <a href={`tel:${siteConfig.phoneRaw}`} class="text-2xl font-black text-emergency-600 hover:underline">
                {siteConfig.phone}
              </a>
              <p class="text-xs text-slate-500 mt-1">Available 24 Hours / 7 Days a Week</p>
            </div>

            <div>
              <strong class="block text-xs uppercase text-slate-500 font-bold mb-1">Email Inquiries:</strong>
              <a href={`mailto:${siteConfig.email}`} class="text-brand-600 font-medium">
                {siteConfig.email}
              </a>
            </div>

            <div>
              <strong class="block text-xs uppercase text-slate-500 font-bold mb-1">Primary Service Hub:</strong>
              <p class="text-slate-800 font-medium">
                Denton, TX {siteConfig.postalCode}
              </p>
              <p class="text-xs text-slate-500 mt-1">Serving all Denton neighborhoods & Denton County</p>
            </div>

            <div>
              <strong class="block text-xs uppercase text-slate-500 font-bold mb-1">Operating Hours:</strong>
              <p class="text-slate-800 font-medium">
                Monday – Sunday: 24 Hours Open (Emergency Service Always Active)
              </p>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm">
          <strong class="block font-bold mb-1">⚡ For Active Flooding / Burst Pipes:</strong>
          <p class="text-xs text-amber-800 mb-3">
            Please immediately turn off your main water shutoff valve (usually near your water meter or inside your garage) and call our emergency line directly.
          </p>
          <a href={`tel:${siteConfig.phoneRaw}`} class="inline-block px-4 py-2 bg-amber-600 text-white font-bold text-xs rounded-lg">
            📞 Direct Call: {siteConfig.phone}
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <LeadForm formTitle="Send a Service Request" />
      </div>

    </div>
  </section>
</BaseLayout>
