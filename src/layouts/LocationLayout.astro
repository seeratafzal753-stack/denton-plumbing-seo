---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CallToAction from '../components/CallToAction.astro';
import { siteConfig } from '../siteConfig';

interface Props {
  cityName: string;
  state: string;
  county: string;
  postalCodes: string[];
  neighborhoods: string[];
  metaTitle: string;
  metaDescription: string;
  localLandmarks: string[];
  localPlumbingChallenges: string[];
  faqs: Array<{ question: string; answer: string }>;
}

const {
  cityName,
  state = 'TX',
  county = 'Denton County',
  postalCodes = [],
  neighborhoods = [],
  metaTitle,
  metaDescription,
  localLandmarks = [],
  localPlumbingChallenges = [],
  faqs = [],
} = Astro.props;

const crumbs = [
  { name: 'Service Areas', item: '/service-areas/' },
  { name: `${cityName}, ${state}`, item: Astro.url.pathname },
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  type="LocalBusiness"
  faqs={faqs}
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-brand-950 to-slate-900 text-white py-12 lg:py-16 px-4 sm:px-6 lg:px-8 relative">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 bg-brand-600/80 text-white text-xs uppercase font-bold tracking-widest px-3.5 py-1.5 rounded-full mb-4">
          <span>📍 Local Plumber in {cityName}, {state} ({county})</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight mb-4 text-white">
          Plumbing & Emergency Drain Services in <span class="text-brand-400">{cityName}, {state}</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed">
          Fast, licensed, and affordable 24/7 plumbing repair, water heater replacement, and drain cleaning throughout {cityName} and ZIP codes {postalCodes.join(', ')}.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-emergency-600 hover:bg-emergency-500 text-white font-black text-lg shadow-xl transition transform hover:-translate-y-0.5"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            <span>Call Plumber: {siteConfig.phone}</span>
          </a>

          <a
            href="#estimate-form"
            class="flex items-center justify-center px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base backdrop-blur-sm border border-white/20 transition"
          >
            <span>Get {cityName} Estimate</span>
          </a>
        </div>
      </div>

      <!-- Lead Form -->
      <div id="estimate-form" class="lg:col-span-5">
        <LeadForm formTitle={`Service in ${cityName}, TX`} />
      </div>

    </div>
  </section>

  <TrustBadges />

  <!-- Local Nuances & Soil/Water Conditions -->
  <section class="py-14 bg-white px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">
      
      <div class="p-8 rounded-2xl bg-amber-50/60 border border-amber-200">
        <h2 class="text-xl font-bold text-amber-950 mb-4 flex items-center gap-2">
          <span>⚠️</span> Common Plumbing Challenges in {cityName}, TX
        </h2>
        <ul class="space-y-3 text-slate-800 text-sm">
          {localPlumbingChallenges.map((c) => (
            <li class="flex items-start gap-2">
              <span class="text-amber-700 font-bold">•</span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="p-8 rounded-2xl bg-brand-50/60 border border-brand-200">
        <h2 class="text-xl font-bold text-brand-950 mb-4 flex items-center gap-2">
          <span>📍</span> Neighborhoods & Landmarks We Serve in {cityName}
        </h2>
        <div class="mb-4">
          <h3 class="text-xs uppercase font-bold tracking-wider text-slate-600 mb-2">Key Neighborhoods:</h3>
          <div class="flex flex-wrap gap-1.5">
            {neighborhoods.map((n) => (
              <span class="bg-white border border-brand-200 text-slate-700 text-xs px-2.5 py-1 rounded">
                {n}
              </span>
            ))}
          </div>
        </div>
        <div>
          <h3 class="text-xs uppercase font-bold tracking-wider text-slate-600 mb-2">Nearby Landmarks:</h3>
          <p class="text-xs text-slate-600">
            {localLandmarks.join(' • ')}
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Markdown Slot for Deep City Content -->
  <section class="py-12 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto prose prose-slate prose-lg max-w-none">
      <slot />
    </div>
  </section>

  <!-- Local FAQs -->
  <FaqAccordion
    faqs={faqs}
    title={`Frequently Asked Questions: Plumbing in ${cityName}, TX`}
  />

  <CallToAction
    heading={`Need a Fast Plumber in ${cityName}, TX?`}
    subheading={`Our licensed technicians are ready for emergency response throughout ${cityName} and ZIP codes ${postalCodes.join(', ')}.`}
  />
</BaseLayout>
