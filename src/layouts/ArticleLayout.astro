---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../siteConfig';

interface Props {
  title: string;
  metaTitle: string;
  metaDescription: string;
  pubDate: Date;
  author: string;
  category: string;
  targetKeywords?: string[];
  faqs?: Array<{ question: string; answer: string }>;
}

const {
  title,
  metaTitle,
  metaDescription,
  pubDate,
  author,
  category,
  targetKeywords = [],
  faqs = [],
} = Astro.props;

const crumbs = [
  { name: 'Blog', item: '/blog/' },
  { name: title, item: Astro.url.pathname },
];

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  type="Article"
  faqs={faqs}
  breadcrumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />

  <article class="py-10 lg:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Article Header -->
      <header class="mb-10 text-center">
        <div class="inline-flex items-center gap-2 bg-brand-100 text-brand-800 text-xs uppercase font-bold tracking-widest px-3 py-1 rounded-full mb-4">
          <span>{category}</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-6">
          {title}
        </h1>

        <div class="flex flex-wrap items-center justify-center gap-4 text-xs sm:text-sm text-slate-500 border-y border-slate-200 py-3">
          <span>By <strong class="text-slate-800">{author}</strong></span>
          <span>•</span>
          <span class="flex items-center gap-1">
            <Icon name="calendar" class="w-3.5 h-3.5 text-slate-400" />
            <span>Published: {formattedDate}</span>
          </span>
          <span>•</span>
          <span class="flex items-center gap-1">
            <Icon name="map-pin" class="w-3.5 h-3.5 text-slate-400" />
            <span>Region: Denton County, TX</span>
          </span>
        </div>
      </header>

      <!-- In-Article Emergency Dispatch Callout Box -->
      <div class="my-8 p-6 rounded-2xl bg-gradient-to-r from-brand-900 to-slate-900 text-white shadow-lg flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs uppercase font-bold text-amber-400 flex items-center gap-1.5">
            <Icon name="bolt" class="w-3.5 h-3.5 text-amber-400" />
            <span>Dealing With a Plumbing Emergency in Denton?</span>
          </span>
          <h3 class="text-lg font-black text-white mt-0.5">Need a Master Plumber Today?</h3>
          <p class="text-xs text-slate-300">Same-day dispatch across all Denton neighborhoods and ZIP codes.</p>
        </div>
        <a
          href={`tel:${siteConfig.phoneRaw}`}
          class="shrink-0 px-6 py-3 rounded-xl bg-emergency-600 hover:bg-emergency-700 text-white font-bold text-sm shadow transition flex items-center gap-2"
        >
          <Icon name="phone" class="w-4 h-4 text-white" />
          <span>Call {siteConfig.phone}</span>
        </a>
      </div>

      <!-- Main Article Markdown Content -->
      <div class="prose prose-lg prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline">
        <slot />
      </div>

      <!-- Article Keywords / Topics Tag Cloud -->
      {targetKeywords.length > 0 && (
        <div class="mt-12 pt-6 border-t border-slate-200">
          <span class="text-xs uppercase font-bold text-slate-500 block mb-2">Related Denton Topics:</span>
          <div class="flex flex-wrap gap-2">
            {targetKeywords.map((kw) => (
              <span class="bg-slate-100 text-slate-700 text-xs px-3 py-1 rounded-full">
                #{kw}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- FAQs -->
      {faqs.length > 0 && (
        <div class="mt-12">
          <FaqAccordion
            faqs={faqs}
            title="Questions About This Topic"
          />
        </div>
      )}

    </div>
  </article>

  <CallToAction
    heading="Have a Question or Need Service in Denton?"
    subheading="Speak directly with our local Texas licensed plumbing dispatch desk for advice or same-day scheduling."
  />
</BaseLayout>
