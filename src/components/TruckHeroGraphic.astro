---
import { siteConfig } from '../siteConfig';
---

<div class="relative w-full max-w-xl mx-auto lg:max-w-none group">
  <!-- Glow effect beneath truck -->
  <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 w-4/5 h-12 bg-black/60 blur-xl rounded-full"></div>
  
  <svg class="w-full h-auto drop-shadow-2xl transform group-hover:scale-105 transition duration-500" viewBox="0 0 700 350" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Van Body Base -->
    <!-- Chassis / Shadows -->
    <path d="M70 270 L630 270 L620 285 L80 285 Z" fill="#0f172a"/>

    <!-- Main White Van Body -->
    <path d="M80 140 C80 120 95 105 115 105 L470 105 C490 105 510 115 525 130 L590 195 C605 210 615 225 615 245 L615 265 L80 265 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>

    <!-- Front Hood & Bumper -->
    <path d="M590 195 L630 230 C640 240 640 255 640 265 L605 265" fill="#f8fafc" stroke="#94a3b8" stroke-width="2"/>
    <rect x="620" y="245" width="22" height="15" rx="3" fill="#334155"/>
    <!-- Headlight -->
    <polygon points="610,210 635,225 635,240 610,235" fill="#fef08a" stroke="#e2e8f0" stroke-width="1.5"/>

    <!-- Cabin Windows (Dark Tinted Glass) -->
    <path d="M480 120 L515 120 C525 120 535 125 545 138 L580 185 L480 185 Z" fill="#0f172a" stroke="#475569" stroke-width="2"/>
    <path d="M380 120 L465 120 L465 185 L380 185 Z" fill="#1e293b" stroke="#475569" stroke-width="2"/>

    <!-- Driver Silhouette in Window -->
    <circle cx="510" cy="155" r="14" fill="#64748b"/>
    <path d="M495 185 C495 170 525 170 525 185 Z" fill="#dc2626"/>

    <!-- Side Mirrors -->
    <rect x="530" y="175" width="15" height="22" rx="4" fill="#0f172a"/>

    <!-- High-Impact Texas Vehicle Vinyl Wrap / Graphics -->
    <path d="M120 125 L380 125 C410 170 360 240 450 265 L100 265 C90 265 85 240 90 210 Z" fill="#1e3a8a"/>
    <path d="M180 135 L340 135 C380 180 300 230 420 265 L260 265 Z" fill="#dc2626"/>
    
    <!-- Van Text Branding -->
    <text x="135" y="180" fill="#ffffff" font-size="28" font-weight="900" font-family="system-ui, sans-serif" letter-spacing="1">
      DENTON
    </text>
    <text x="135" y="210" fill="#f8fafc" font-size="22" font-weight="800" font-family="system-ui, sans-serif">
      PLUMBING PROS
    </text>
    <text x="135" y="235" fill="#fef08a" font-size="15" font-weight="900" font-family="system-ui, sans-serif">
      24/7 DISPATCH • (940) 310-4499
    </text>

    <!-- License text -->
    <text x="135" y="255" fill="#94a3b8" font-size="10" font-weight="700" font-family="system-ui, sans-serif">
      TX Master Plumber #M-42918 • Licensed & Insured
    </text>

    <!-- Chrome Door Handles & Panels -->
    <rect x="420" y="195" width="22" height="6" rx="3" fill="#64748b"/>
    <line x1="370" y1="110" x2="370" y2="265" stroke="#cbd5e1" stroke-width="1.5"/>
    <line x1="470" y1="110" x2="470" y2="265" stroke="#cbd5e1" stroke-width="1.5"/>

    <!-- Roof Heavy-Duty Ladder Rack -->
    <rect x="130" y="90" width="360" height="8" rx="2" fill="#64748b"/>
    <rect x="160" y="98" width="10" height="8" fill="#475569"/>
    <rect x="300" y="98" width="10" height="8" fill="#475569"/>
    <rect x="440" y="98" width="10" height="8" fill="#475569"/>
    <!-- Yellow Extension Ladder on Top -->
    <rect x="110" y="78" width="400" height="12" rx="3" fill="#f59e0b" stroke="#d97706" stroke-width="1.5"/>
    <line x1="150" y1="78" x2="150" y2="90" stroke="#78350f" stroke-width="2"/>
    <line x1="200" y1="78" x2="200" y2="90" stroke="#78350f" stroke-width="2"/>
    <line x1="250" y1="78" x2="250" y2="90" stroke="#78350f" stroke-width="2"/>
    <line x1="300" y1="78" x2="300" y2="90" stroke="#78350f" stroke-width="2"/>
    <line x1="350" y1="78" x2="350" y2="90" stroke="#78350f" stroke-width="2"/>
    <line x1="400" y1="78" x2="400" y2="90" stroke="#78350f" stroke-width="2"/>
    <line x1="450" y1="78" x2="450" y2="90" stroke="#78350f" stroke-width="2"/>
    <line x1="490" y1="78" x2="490" y2="90" stroke="#78350f" stroke-width="2"/>

    <!-- Front Wheel -->
    <circle cx="535" cy="270" r="38" fill="#0f172a"/>
    <circle cx="535" cy="270" r="26" fill="#475569"/>
    <circle cx="535" cy="270" r="18" fill="#cbd5e1"/>
    <!-- 5-Spoke Chrome Rim -->
    <circle cx="535" cy="270" r="6" fill="#0f172a"/>
    <line x1="535" y1="245" x2="535" y2="295" stroke="#94a3b8" stroke-width="4"/>
    <line x1="510" y1="270" x2="560" y2="270" stroke="#94a3b8" stroke-width="4"/>

    <!-- Rear Wheel -->
    <circle cx="185" cy="270" r="38" fill="#0f172a"/>
    <circle cx="185" cy="270" r="26" fill="#475569"/>
    <circle cx="185" cy="270" r="18" fill="#cbd5e1"/>
    <!-- 5-Spoke Chrome Rim -->
    <circle cx="185" cy="270" r="6" fill="#0f172a"/>
    <line x1="185" y1="245" x2="185" y2="295" stroke="#94a3b8" stroke-width="4"/>
    <line x1="160" y1="270" x2="210" y2="270" stroke="#94a3b8" stroke-width="4"/>
  </svg>
</div>
