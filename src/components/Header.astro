---
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const servicesList: Array<{ name: string; href: string; tag: string; icon: 'alert' | 'flame' | 'droplet' | 'search' | 'wrench' | 'clipboard' }> = [
  { name: 'Emergency Plumbing', href: '/denton-tx/emergency-plumbing/', tag: '24/7 Urgent', icon: 'alert' },
  { name: 'Water Heaters', href: '/denton-tx/water-heater-repair/', tag: 'Tank & Tankless', icon: 'flame' },
  { name: 'Drain Cleaning', href: '/denton-tx/drain-cleaning/', tag: 'Hydro-Jetting', icon: 'droplet' },
  { name: 'Slab Leaks', href: '/denton-tx/slab-leak-repair/', tag: 'Non-Invasive', icon: 'search' },
  { name: 'Sewer Line Repair', href: '/denton-tx/sewer-line-repair/', tag: 'Camera Inspection', icon: 'wrench' },
  { name: 'All Services', href: '/services/', tag: 'Full Directory', icon: 'clipboard' },
];
---

<header class="w-full sticky top-0 z-50 shadow-lg font-sans">
  
  <!-- 1. TOP WHITE BAR: LOGO + 3 HIGH-IMPACT ACTION BUTTONS -->
  <div class="bg-white border-b border-slate-200 py-2.5 sm:py-3 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      
      <!-- LOGO: Texas Style Bold Branding -->
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0" aria-label="Denton Plumbing Pros Homepage">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-lg bg-[#c8102e] flex items-center justify-center shadow-md text-white p-1.5 group-hover:scale-105 transition transform shrink-0">
          <Icon name="wrench" class="w-6 h-6 text-white" />
        </div>
        <div>
          <span class="block font-black text-xl sm:text-2xl tracking-tighter uppercase text-slate-900 leading-none">
            DENTON <span class="text-[#c8102e]">PLUMBING</span>
          </span>
          <span class="block text-[9px] sm:text-[10px] font-extrabold uppercase tracking-widest text-slate-500 mt-0.5">
            PROS REFERRAL NETWORK • DENTON, TX
          </span>
        </div>
      </a>

      <!-- RIGHT 3 ACTION BUTTONS (Desktop) -->
      <div class="hidden md:flex items-center gap-2.5 lg:gap-3">
        
        <!-- Button 1: Navy Blue Phone Button -->
        <a
          href={`tel:${siteConfig.phoneRaw}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-[#1a2b4c] hover:bg-[#121e35] text-white font-extrabold text-xs lg:text-sm shadow transition transform hover:-translate-y-0.5"
          aria-label={`Call ${siteConfig.phone}`}
        >
          <Icon name="phone" class="w-4 h-4 text-sky-400" />
          <span>{siteConfig.phone}</span>
        </a>

        <!-- Button 2: Texas Red Schedule / Request Button -->
        <a
          href="#estimate-form"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-[#c8102e] hover:bg-[#a60c24] text-white font-extrabold text-xs lg:text-sm uppercase tracking-wide shadow-md transition transform hover:-translate-y-0.5"
        >
          <Icon name="calendar" class="w-4 h-4 text-white" />
          <span>Schedule Service</span>
        </a>

        <!-- Button 3: Dark Charcoal 24/7 Match Button -->
        <a
          href="#estimate-form"
          class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-md bg-[#27323f] hover:bg-[#1a222c] text-white font-extrabold text-xs lg:text-sm uppercase tracking-wide shadow transition transform hover:-translate-y-0.5"
        >
          <span class="text-amber-400 font-black">$</span>
          <span>Free Quotes</span>
        </a>

      </div>

      <!-- Mobile Call & Menu Button -->
      <div class="flex md:hidden items-center gap-2">
        <a
          href={`tel:${siteConfig.phoneRaw}`}
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md bg-[#c8102e] text-white font-black text-xs uppercase shadow"
        >
          <Icon name="phone" class="w-3.5 h-3.5 text-white" />
          <span>Call</span>
        </a>

        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-md bg-slate-100 text-slate-800 hover:bg-slate-200 focus:outline-none"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- 2. BOTTOM MAROON/CRIMSON NAVIGATION BAR (Exact Match to Screenshot) -->
  <div class="bg-gradient-to-r from-[#2c0505] via-[#4d0b0b] to-[#200404] border-b border-[#631010] px-4 sm:px-6 lg:px-8 py-2">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- DESKTOP NAV -->
      <nav class="hidden md:flex items-center space-x-5 lg:space-x-8 text-xs lg:text-sm font-black uppercase tracking-wider text-white">
        
        <!-- Residential / Services Dropdown -->
        <div class="relative group">
          <button
            type="button"
            class="flex items-center gap-1.5 py-1 text-white hover:text-red-300 font-black uppercase tracking-wider transition-colors"
          >
            <span>Residential</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-red-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Panel -->
          <div class="absolute top-full left-0 w-72 bg-slate-900 rounded-xl shadow-2xl border border-slate-700 py-2 hidden group-hover:block transition-all duration-150 z-50 mt-1">
            <div class="px-4 py-2 text-[10px] font-black uppercase text-slate-400 tracking-wider border-b border-slate-800 flex items-center justify-between">
              <span>Denton Services</span>
              <span class="text-red-400 font-bold">24/7 Match</span>
            </div>
            <div class="p-1 space-y-0.5">
              {servicesList.map((service) => (
                <a
                  href={service.href}
                  class="flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-bold text-slate-200 hover:bg-[#c8102e] hover:text-white transition-colors"
                >
                  <div class="flex items-center gap-2.5">
                    <Icon name={service.icon} class="w-3.5 h-3.5 text-red-400" />
                    <span>{service.name}</span>
                  </div>
                  <span class="text-[10px] font-semibold text-slate-400 bg-slate-800 px-2 py-0.5 rounded">
                    {service.tag}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/denton-tx/water-heater-repair/" class="hover:text-red-300 transition-colors">Water Heaters</a>
        <a href="/denton-tx/slab-leak-repair/" class="hover:text-red-300 transition-colors">Slab Leaks</a>
        <a href="/denton-tx/drain-cleaning/" class="hover:text-red-300 transition-colors">Drain Cleaning</a>
        <a href="/service-areas/" class="hover:text-red-300 transition-colors">Service Areas</a>
        <a href="/blog/" class="hover:text-red-300 transition-colors">Blog</a>
        <a href="/contact/" class="hover:text-red-300 transition-colors">Contact</a>

      </nav>

      <!-- Right Promo Tag in Nav Bar -->
      <div class="hidden lg:flex items-center gap-2 text-white/90 text-xs font-extrabold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>24/7 Live Dispatch: (940) 310-4499</span>
      </div>

    </div>
  </div>

  <!-- MOBILE MENU ACCORDION -->
  <div id="mobile-menu" class="hidden md:hidden bg-slate-950 text-white border-b border-slate-800 px-4 py-4 space-y-3 font-sans">
    <div class="space-y-1 text-sm font-bold">
      <a href="/" class="block py-2 px-3 rounded-lg hover:bg-slate-800 text-red-400">Home</a>
      <a href="/denton-tx/emergency-plumbing/" class="block py-2 px-3 rounded-lg hover:bg-slate-800">Emergency Plumbing</a>
      <a href="/denton-tx/water-heater-repair/" class="block py-2 px-3 rounded-lg hover:bg-slate-800">Water Heater Repair</a>
      <a href="/denton-tx/slab-leak-repair/" class="block py-2 px-3 rounded-lg hover:bg-slate-800">Slab Leak Detection</a>
      <a href="/denton-tx/drain-cleaning/" class="block py-2 px-3 rounded-lg hover:bg-slate-800">Drain Cleaning</a>
      <a href="/service-areas/" class="block py-2 px-3 rounded-lg hover:bg-slate-800">Service Areas</a>
      <a href="/blog/" class="block py-2 px-3 rounded-lg hover:bg-slate-800">Plumbing Guides</a>
      <a href="/contact/" class="block py-2 px-3 rounded-lg hover:bg-slate-800">Contact Us</a>
    </div>

    <div class="pt-3 border-t border-slate-800 space-y-2">
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="block w-full text-center py-3 rounded-lg bg-[#1a2b4c] text-white font-black text-sm shadow flex items-center justify-center gap-2"
      >
        <Icon name="phone" class="w-4 h-4 text-sky-400" />
        <span>Call {siteConfig.phone}</span>
      </a>
      <a
        href="#estimate-form"
        class="block w-full text-center py-3 rounded-lg bg-[#c8102e] text-white font-black text-sm uppercase tracking-wider shadow"
      >
        Schedule Service
      </a>
    </div>
  </div>

</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
