---
import { siteConfig } from '../siteConfig';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Water Heaters', href: '/denton-tx/water-heater-repair/' },
  { name: 'Drain Cleaning', href: '/denton-tx/drain-cleaning/' },
  { name: 'Slab Leaks', href: '/denton-tx/slab-leak-repair/' },
  { name: 'Emergency Plumbing', href: '/denton-tx/emergency-plumbing/' },
  { name: 'All Services', href: '/services/' },
  { name: 'Service Areas', href: '/service-areas/' },
  { name: 'Blog', href: '/blog/' },
  { name: 'Contact', href: '/contact/' },
];
---

<header class="w-full bg-white sticky top-0 z-50 shadow-md">
  
  <!-- 1. SLIM EMERGENCY ANNOUNCEMENT BAR AT THE VERY TOP -->
  <div class="bg-red-600 text-white py-2 px-4 shadow-sm border-b border-red-700">
    <div class="max-w-7xl mx-auto flex items-center justify-center sm:justify-between text-center sm:text-left">
      
      <!-- Strong Red / High-Visibility Urgency Text -->
      <div class="flex items-center justify-center gap-2.5 mx-auto sm:mx-0">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-90"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
        </span>
        <span class="text-xs sm:text-sm font-extrabold tracking-wide uppercase text-white drop-shadow-sm">
          Plumbing Emergency? We’re Available 24/7/365
        </span>
      </div>

      <!-- Right Support Notice (Desktop) -->
      <div class="hidden md:flex items-center gap-4 text-xs font-bold text-red-100">
        <span>⚡ 28–35 Min Avg Arrival Across Denton County</span>
        <span>•</span>
        <a href={`tel:${siteConfig.phoneRaw}`} class="text-white hover:text-amber-200 underline font-black transition">
          Direct Line: {siteConfig.phone}
        </a>
      </div>

    </div>
  </div>

  <!-- 2. MAIN HEADER (BELOW EMERGENCY BAR) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center bg-white">
    
    <!-- LEFT: Professional Plumbing Company Logo & Name with Mascot -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <div class="relative w-12 h-12 rounded-xl bg-gradient-to-br from-brand-900 via-brand-800 to-slate-950 flex items-center justify-center shadow-md border border-brand-700 group-hover:scale-105 transition transform overflow-hidden p-0.5">
        <img
          src="/images/plumber-mascot.png"
          alt="Denton Plumber Mascot"
          class="w-full h-full object-contain object-top"
          width="48"
          height="48"
        />
      </div>
      <div>
        <span class="block font-black text-xl sm:text-2xl text-slate-900 leading-none tracking-tight">
          Denton<span class="text-brand-700">Plumbing</span><span class="text-red-600">Pros</span>
        </span>
        <span class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider mt-1">
          Licensed Master Plumbers • Lic #M-42918
        </span>
      </div>
    </a>

    <!-- CENTER: Horizontally Aligned, Spacious Navigation Menu -->
    <nav class="hidden xl:flex items-center space-x-5 2xl:space-x-7">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`text-sm font-bold transition tracking-tight ${
            currentPath === link.href
              ? 'text-red-600 border-b-2 border-red-600 pb-1'
              : 'text-slate-700 hover:text-red-600'
          }`}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- RIGHT: Prominent Phone Number & Professional BOOK NOW CTA -->
    <div class="flex items-center gap-3 sm:gap-4 shrink-0">
      
      <!-- Prominent Phone Number -->
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="hidden sm:flex flex-col items-end text-right group"
      >
        <span class="text-[10px] uppercase font-black tracking-widest text-slate-500">24/7 Live Dispatch</span>
        <span class="text-base lg:text-lg font-black text-slate-900 group-hover:text-red-600 transition tracking-tight flex items-center gap-1.5">
          <span class="text-red-600">📞</span>
          {siteConfig.phone}
        </span>
      </a>

      <!-- Professional BOOK NOW High-Conversion CTA Button -->
      <a
        href="#estimate-form"
        class="inline-flex items-center justify-center px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-black text-xs sm:text-sm uppercase tracking-wider shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 active:translate-y-0"
      >
        <span>BOOK NOW</span>
      </a>

      <!-- Mobile Menu Hamburger Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        class="xl:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100 focus:outline-none"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

    </div>

  </div>

  <!-- Subtle Bottom Border Accent -->
  <div class="h-0.5 w-full bg-slate-100"></div>

  <!-- Mobile Navigation Menu Drawer -->
  <div id="mobile-menu" class="hidden xl:hidden bg-white border-t border-slate-200 px-4 py-4 space-y-2 shadow-2xl">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block py-2.5 px-3 rounded-lg text-sm font-bold text-slate-800 hover:bg-red-50 hover:text-red-600 transition"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-4 border-t border-slate-100 space-y-2">
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="block w-full text-center py-3.5 rounded-xl bg-slate-900 text-white font-black text-sm shadow flex items-center justify-center gap-2"
      >
        <span>📞 Call (940) 310-4499</span>
      </a>
      <a
        href="#estimate-form"
        class="block w-full text-center py-3.5 rounded-xl bg-red-600 text-white font-black text-sm uppercase tracking-wider shadow"
      >
        BOOK NOW
      </a>
    </div>
  </div>

</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
