---
import { siteConfig } from '../siteConfig';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Water Heaters', href: '/denton-tx/water-heater-repair/' },
  { name: 'Drain Cleaning', href: '/denton-tx/drain-cleaning/' },
  { name: 'Slab Leaks', href: '/denton-tx/slab-leak-repair/' },
  { name: 'Emergency Plumbing', href: '/denton-tx/emergency-plumbing/' },
  { name: 'All Services', href: '/services/' },
  { name: 'Service Areas', href: '/service-areas/' },
  { name: 'Blog', href: '/blog/' },
  { name: 'Contact', href: '/contact/' },
];
---

<header class="w-full bg-white sticky top-0 z-50 shadow-sm">
  
  <!-- FIRST LINE: Clean, Clear & Prominent 24/7/365 Emergency Bar -->
  <div class="bg-slate-950 text-white text-xs sm:text-sm py-2.5 px-4 border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Exact Requested Line -->
      <div class="flex items-center gap-2 font-bold tracking-wide">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
        <span class="text-white sm:text-sm text-xs font-extrabold">
          Plumbing Emergency? We’re Available 24/7/365
        </span>
      </div>

      <!-- Right Support Call -->
      <div class="hidden sm:flex items-center gap-3 text-xs text-slate-300">
        <span>Serving All Denton County ZIPs</span>
        <span class="text-slate-600">|</span>
        <a href={`tel:${siteConfig.phoneRaw}`} class="text-amber-400 hover:text-amber-300 font-black transition">
          📞 {siteConfig.phone}
        </a>
      </div>

    </div>
  </div>

  <!-- SECOND LINE: Website Name, Navigation, Clear Phone Number & Clear Book Now Button -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex justify-between items-center">
    
    <!-- Website Name / Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-lg bg-brand-800 flex items-center justify-center text-white font-black text-lg shadow-sm group-hover:bg-brand-900 transition">
        DP
      </div>
      <div>
        <span class="block font-black text-xl sm:text-2xl text-slate-900 leading-tight tracking-tight">
          Denton<span class="text-brand-700">Plumbing</span>Pros
        </span>
        <span class="block text-[10px] uppercase font-bold text-slate-500 tracking-wider">
          TSBPE Master Plumber #M-42918
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden xl:flex items-center space-x-6">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`text-sm font-semibold transition ${
            currentPath === link.href
              ? 'text-brand-700 font-bold border-b-2 border-brand-700 pb-0.5'
              : 'text-slate-700 hover:text-brand-700'
          }`}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Clear Phone Number & Clear Book Now Button -->
    <div class="flex items-center gap-3 sm:gap-4">
      
      <!-- Clear Phone Number -->
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="hidden sm:flex items-center gap-2 font-black text-slate-900 hover:text-brand-700 text-sm md:text-base transition px-2 py-1"
      >
        <span class="text-brand-700 text-base">📞</span>
        <span>{siteConfig.phone}</span>
      </a>

      <!-- Clear Book Now Button -->
      <a
        href="#estimate-form"
        class="inline-flex items-center justify-center px-5 sm:px-6 py-2.5 rounded-full bg-brand-700 hover:bg-brand-800 text-white font-black text-xs sm:text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5"
      >
        BOOK NOW
      </a>

      <!-- Mobile Menu Hamburger Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        class="xl:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100 focus:outline-none"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

    </div>

  </div>

  <!-- Thin Accent Border Line -->
  <div class="h-0.5 w-full bg-slate-200"></div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="hidden xl:hidden bg-white border-t border-slate-200 px-4 py-4 space-y-2 shadow-lg">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block py-2 px-3 rounded-md text-sm font-semibold text-slate-800 hover:bg-slate-50 hover:text-brand-700"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-3 border-t border-slate-100 space-y-2">
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="block w-full text-center py-3 rounded-full bg-slate-900 text-white font-bold text-sm shadow"
      >
        📞 Call (940) 310-4499
      </a>
      <a
        href="#estimate-form"
        class="block w-full text-center py-3 rounded-full bg-brand-700 text-white font-black text-sm uppercase shadow"
      >
        BOOK NOW
      </a>
    </div>
  </div>

</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
