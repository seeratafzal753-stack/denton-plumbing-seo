---
import { siteConfig } from '../siteConfig';
import MascotBadge from './MascotBadge.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Emergency Plumbing', href: '/denton-tx/emergency-plumbing/' },
  { name: 'Water Heaters', href: '/denton-tx/water-heater-repair/' },
  { name: 'Drain Cleaning', href: '/denton-tx/drain-cleaning/' },
  { name: 'Slab Leaks', href: '/denton-tx/slab-leak-repair/' },
  { name: 'All Services', href: '/services/' },
  { name: 'Denton Hub', href: '/denton-tx/' },
  { name: 'Guides & Blog', href: '/blog/' },
  { name: 'Contact', href: '/contact/' },
];
---

<header class="w-full bg-white border-b border-slate-200 sticky top-0 z-40 shadow-md">
  
  <!-- Reference Layout Top Action Pill Bar (Dark Navy Header Bar) -->
  <div class="bg-slate-950 text-white text-xs sm:text-sm py-2.5 px-4 border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      
      <!-- Left Live Indicator -->
      <div class="flex items-center space-x-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse-live"></span>
        <span class="font-black text-emerald-400 uppercase tracking-wider text-xs">24/7 DENTON EMERGENCY DISPATCH</span>
        <span class="hidden lg:inline text-slate-400">| TSBPE Master Plumber #M-42918</span>
      </div>

      <!-- Right 3 Action Pill Buttons Matching Reference -->
      <div class="flex items-center space-x-2">
        <!-- Pill 1: Blue Phone -->
        <a
          href={`tel:${siteConfig.phoneRaw}`}
          class="px-3.5 py-1 rounded-full bg-brand-700 hover:bg-brand-600 text-white font-black text-xs flex items-center gap-1 shadow-sm transition"
        >
          <span>📞</span>
          <span>{siteConfig.phone}</span>
        </a>

        <!-- Pill 2: Red Schedule -->
        <a
          href="/contact/"
          class="px-3.5 py-1 rounded-full bg-emergency-600 hover:bg-emergency-500 text-white font-black text-xs uppercase tracking-wider shadow-sm transition"
        >
          <span>SCHEDULE SERVICE</span>
        </a>

        <!-- Pill 3: Dark Account / Specials -->
        <a
          href="#neighborhoods"
          class="hidden md:inline-flex px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs shadow-sm transition"
        >
          <span>VIEW ETAS</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Main Navigation Bar with Mascot Logo -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center">
    
    <!-- Brand Logo with Mascot Emblem -->
    <a href="/" class="flex items-center gap-3 group">
      <MascotBadge size="sm" />
      <div>
        <span class="block font-black text-xl sm:text-2xl text-slate-900 leading-tight">
          DENTON<span class="text-emergency-600">PLUMBING</span>PROS
        </span>
        <span class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1">
          <span class="text-emergency-600 font-black">★</span> YOUR LOCAL EXPERT PLUMBER
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden xl:flex items-center space-x-5">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`text-xs font-black uppercase tracking-wider transition ${
            currentPath === link.href
              ? 'text-emergency-600 border-b-2 border-emergency-600 pb-1'
              : 'text-slate-700 hover:text-emergency-600'
          }`}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Header Right Quick Call Button -->
    <div class="flex items-center gap-3">
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-xl bg-emergency-600 hover:bg-emergency-700 text-white font-black text-xs sm:text-sm shadow-md transition transform hover:-translate-y-0.5 uppercase"
      >
        <span>📞 (940) 310-4499</span>
      </a>

      <!-- Mobile Menu Hamburger Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        class="xl:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100 focus:outline-none"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="hidden xl:hidden bg-white border-t border-slate-200 px-4 py-3 space-y-2">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block py-2 px-3 rounded-md text-sm font-bold text-slate-800 hover:bg-emergency-50 hover:text-emergency-600"
      >
        {link.name}
      </a>
    ))}
    <a
      href={`tel:${siteConfig.phoneRaw}`}
      class="block w-full text-center py-3 rounded-xl bg-emergency-600 text-white font-black text-sm uppercase shadow mt-3"
    >
      📞 Call Denton Dispatch: {siteConfig.phone}
    </a>
  </div>

</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
