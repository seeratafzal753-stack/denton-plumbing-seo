---
import { siteConfig } from '../siteConfig';
---

<!-- Fixed Mobile Bottom CTA Bar (Split CALL NOW | BOOK SERVICE) -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-slate-950/95 backdrop-blur-md px-3 py-2 border-t border-slate-800 shadow-2xl safe-area-inset-bottom">
  <div class="max-w-lg mx-auto grid grid-cols-2 gap-2.5">
    
    <!-- Red Call Now Action -->
    <a
      href={`tel:${siteConfig.phoneRaw}`}
      class="flex items-center justify-center gap-1.5 py-3 px-3 rounded-xl bg-red-600 active:bg-red-700 text-white font-black text-xs sm:text-sm shadow-md transition transform active:scale-95 text-center"
      aria-label="Call Denton Plumbing Pros"
    >
      <span class="text-sm">📞</span>
      <span>CALL NOW</span>
    </a>

    <!-- Navy Book Service Action -->
    <a
      href="#estimate-form"
      class="flex items-center justify-center gap-1.5 py-3 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 active:bg-slate-900 text-white font-black text-xs sm:text-sm border border-slate-700 shadow-md transition transform active:scale-95 text-center"
      aria-label="Book Denton Plumbing Service"
    >
      <span>BOOK SERVICE</span>
    </a>

  </div>
</div>

