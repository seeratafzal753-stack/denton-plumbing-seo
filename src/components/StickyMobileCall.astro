---
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';
---

<!-- Fixed Mobile Bottom CTA Bar (Clean White & Texas Red Theme) -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md px-3 py-2 border-t border-slate-200 shadow-2xl safe-area-inset-bottom">
  <div class="max-w-lg mx-auto grid grid-cols-2 gap-2.5">
    
    <!-- Red Call Now Action -->
    <a
      href={`tel:${siteConfig.phoneRaw}`}
      class="flex items-center justify-center gap-2 py-3 px-3 rounded-full bg-[#c8102e] active:bg-[#a60c24] text-white font-black text-xs sm:text-sm shadow-md transition transform active:scale-95 text-center min-h-[48px]"
      aria-label="Call Denton Plumbing Referral Desk"
    >
      <Icon name="phone" class="w-4 h-4 text-white" />
      <span>CALL NOW</span>
    </a>

    <!-- Navy Request Pro Action -->
    <a
      href="#estimate-form"
      class="flex items-center justify-center gap-2 py-3 px-3 rounded-full bg-[#1a2b4c] hover:bg-[#121e35] active:bg-[#0f172a] text-white font-black text-xs sm:text-sm shadow-md transition transform active:scale-95 text-center min-h-[48px]"
      aria-label="Request a Local Plumbing Pro"
    >
      <Icon name="calendar" class="w-4 h-4 text-sky-400" />
      <span>REQUEST PRO</span>
    </a>

  </div>
</div>
