---
import { siteConfig } from '../siteConfig';
---

<!-- Fixed Mobile Bottom Call Bar -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-slate-950/95 backdrop-blur-md p-2.5 border-t border-slate-800 shadow-2xl">
  <div class="max-w-md mx-auto flex items-center gap-2">
    <a
      href={`tel:${siteConfig.phoneRaw}`}
      class="flex-1 flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-emergency-600 active:bg-emergency-700 text-white font-black text-base shadow-lg transition transform active:scale-95 animate-pulse-live"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
      </svg>
      <span>CALL NOW (940) 310-4499</span>
    </a>
  </div>
</div>
