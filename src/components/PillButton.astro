---
interface Props {
  text?: string;
  href?: string;
  className?: string;
  variant?: 'outline' | 'filled' | 'dark';
}

const {
  text = 'Contact Us Today',
  href = 'tel:+19403104499',
  className = '',
  variant = 'outline',
} = Astro.props;

const variantClasses = {
  outline: 'border-2 border-brand-700 text-brand-800 bg-white hover:bg-brand-700 hover:text-white shadow-sm',
  filled: 'bg-brand-700 text-white hover:bg-brand-800 border-2 border-brand-700 shadow-md',
  dark: 'bg-slate-900 text-white hover:bg-slate-800 border-2 border-slate-900 shadow-md',
};
---

<a
  href={href}
  class={`inline-flex items-center justify-between gap-3 px-6 py-2.5 rounded-full font-bold text-sm sm:text-base transition-all duration-300 transform hover:-translate-y-0.5 group ${variantClasses[variant]} ${className}`}
>
  <span>{text}</span>
  <span class="w-6 h-6 rounded-full bg-brand-700 text-white group-hover:bg-white group-hover:text-brand-700 flex items-center justify-center text-xs transition duration-300 shrink-0">
    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
    </svg>
  </span>
</a>
