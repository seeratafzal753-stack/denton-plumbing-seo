---
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';

interface Props {
  formTitle?: string;
  servicePreselect?: string;
}

const {
  formTitle = "Need a Plumber in Denton?",
  servicePreselect = ""
} = Astro.props;
---

<div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-6 sm:p-8">
  <div class="mb-6 text-center sm:text-left">
    <div class="inline-flex items-center gap-1.5 bg-red-50 text-red-700 text-xs font-bold px-2.5 py-1 rounded-full mb-2 border border-red-100">
      <Icon name="bolt" class="w-3.5 h-3.5 text-red-600" />
      <span>Fast Local Response</span>
    </div>
    <h3 class="text-xl sm:text-2xl font-black text-slate-900 font-serif">{formTitle}</h3>
    <p class="text-xs sm:text-sm text-slate-600 mt-1">
      Tell us what you need and we'll help connect you with a local plumbing professional, or call directly: 
      <a href={`tel:${siteConfig.phoneRaw}`} class="font-bold text-red-600 underline">
        {siteConfig.phone}
      </a>
    </p>
  </div>

  <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you! Your request has been received. A local Denton plumbing professional will call you back shortly.');">
    <div>
      <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Your Full Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder="e.g. John Miller"
        class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm outline-none transition"
      />
    </div>

    <div>
      <label for="phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Phone Number</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        placeholder="(940) 555-0199"
        class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm outline-none transition"
      />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="service" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Service Needed</label>
        <select
          id="service"
          name="service"
          required
          class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm outline-none transition bg-white text-slate-800"
        >
          <option value="" disabled selected={!servicePreselect}>Select a service</option>
          <option value="Emergency Plumbing" selected={servicePreselect === "Emergency Plumbing"}>Emergency Plumbing</option>
          <option value="Water Heater Repair" selected={servicePreselect === "Water Heater Repair" || servicePreselect === "Water Heaters"}>Water Heater Repair</option>
          <option value="Drain Cleaning" selected={servicePreselect === "Drain Cleaning"}>Drain Cleaning</option>
          <option value="Slab Leak Repair" selected={servicePreselect === "Slab Leak Detection" || servicePreselect === "Slab Leak Repair" || servicePreselect === "Slab Leaks"}>Slab Leak Repair</option>
          <option value="Sewer Line Repair" selected={servicePreselect === "Sewer Line Repair"}>Sewer Line Repair</option>
          <option value="Plumbing Repair" selected={servicePreselect === "Plumbing Repair"}>Plumbing Repair</option>
          <option value="Other" selected={servicePreselect === "Other"}>Other</option>
        </select>
      </div>

      <div>
        <label for="zip" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Denton Area ZIP Code</label>
        <input
          type="text"
          id="zip"
          name="zip"
          placeholder="e.g. 76201"
          class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm outline-none transition"
        />
      </div>
    </div>

    <div>
      <label for="details" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Brief Description of Problem</label>
      <textarea
        id="details"
        name="details"
        rows="2"
        placeholder="e.g. Water leaking from base of water heater, toilet clogged..."
        class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm outline-none transition"
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full py-4 px-6 rounded-xl bg-red-600 hover:bg-red-700 active:bg-red-800 text-white font-black text-base shadow-lg shadow-red-600/20 hover:shadow-xl hover:shadow-red-600/30 transition transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 cursor-pointer uppercase tracking-wider"
    >
      <Icon name="phone" class="w-5 h-5 text-white" />
      <span>REQUEST A PLUMBER CALL BACK</span>
    </button>

    <div class="flex items-center justify-center gap-3 text-xs text-slate-500 pt-1">
      <span class="flex items-center gap-1">
        <Icon name="lock" class="w-3.5 h-3.5 text-slate-400" />
        <span>Privacy</span>
      </span>
      <span>•</span>
      <span class="flex items-center gap-1">
        <Icon name="shield-check" class="w-3.5 h-3.5 text-emerald-600" />
        <span>No Spam</span>
      </span>
      <span>•</span>
      <span class="flex items-center gap-1">
        <Icon name="bolt" class="w-3.5 h-3.5 text-amber-500" />
        <span>Fast Response</span>
      </span>
    </div>

    <p class="text-[10px] text-slate-400 text-center leading-relaxed pt-2 border-t border-slate-100">
      By clicking above, you agree to our <a href="/terms-and-conditions/" class="underline text-slate-600 hover:text-black">Terms &amp; Conditions</a> and <a href="/privacy-policy/" class="underline text-slate-600 hover:text-black">Privacy Policy</a>, and authorize local plumbing professionals to contact you regarding your request.
    </p>
  </form>
</div>
