---
import Icon from './Icon.astro';

const trustItems: Array<{
  icon: 'shield-check' | 'bolt' | 'dollar' | 'wrench' | 'lock';
  title: string;
  subtitle: string;
}> = [
  {
    icon: 'shield-check',
    title: 'Verified Local Network',
    subtitle: 'Independent Denton Specialists',
  },
  {
    icon: 'bolt',
    title: 'Rapid Dispatch Match',
    subtitle: 'Priority Denton County Wide',
  },
  {
    icon: 'dollar',
    title: 'Upfront Quotes',
    subtitle: 'Clear Pricing Before Work',
  },
  {
    icon: 'wrench',
    title: 'Full Service Range',
    subtitle: 'Heaters, Drains & Slabs',
  },
  {
    icon: 'lock',
    title: '100% Free Referral',
    subtitle: 'No-Obligation Matching',
  },
];
---

<!-- DEDICATED FULL-WIDTH TRUST BAR (Texas Red Accent Styling) -->
<section class="bg-slate-50 border-b border-slate-200 py-6 px-4 sm:px-6 lg:px-8 shadow-inner">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
      {trustItems.map((item) => (
        <div class="bg-white hover:bg-red-50/40 border border-slate-200 hover:border-[#c8102e] rounded-2xl p-3.5 sm:p-4 flex items-center gap-3 transition-all duration-200 shadow-sm hover:shadow-md hover:shadow-red-500/10 group">
          <div class="w-10 h-10 rounded-xl bg-red-50 text-[#c8102e] group-hover:bg-[#c8102e] group-hover:text-white flex items-center justify-center shrink-0 border border-red-200/80 group-hover:border-[#c8102e] group-hover:scale-105 transition-all duration-200 shadow-sm">
            <Icon name={item.icon} class="w-5 h-5 transition-colors" />
          </div>
          <div class="min-w-0">
            <span class="block text-xs sm:text-sm font-extrabold text-slate-900 group-hover:text-[#c8102e] transition-colors leading-tight truncate">
              {item.title}
            </span>
            <span class="block text-[11px] text-slate-500 font-medium mt-0.5 truncate">
              {item.subtitle}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
