---
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';

const recentJobs = [
  {
    location: "Locust St near Historic Downtown Square",
    zip: "76201",
    service: "Emergency Main Sewer Hydro-Jetting",
    time: "42 mins ago",
    status: "Resolved - Full Flow Restored",
    tech: "Lead Tech Aaron (Truck #2)",
  },
  {
    location: "Nottingham Dr (Idiots Hill)",
    zip: "76209",
    service: "50-Gal Rheem Gas Water Heater Replacement",
    time: "2 hours ago",
    status: "Completed - Code Compliant",
    tech: "Master Plumber David (Truck #1)",
  },
  {
    location: "Teasley Ln (Southridge Subdivision)",
    zip: "76205",
    service: "Acoustic Slab Leak Tracing & PEX Attic Reroute",
    time: "4 hours ago",
    status: "Diagnostic & Reroute Complete",
    tech: "Specialist Marcus (Truck #4)",
  },
  {
    location: "Rayzor Ranch Blvd (West University)",
    zip: "76207",
    service: "Tankless Navien Descaling Flush & Error Clear",
    time: "Today at 11:30 AM",
    status: "Completed",
    tech: "Tech Jesse (Truck #3)",
  },
  {
    location: "Windsor Dr near North Lakes Park",
    zip: "76207",
    service: "Pressure Reducing Valve (PRV) Replacement",
    time: "Today at 9:15 AM",
    status: "Pressure Adjusted to 65 PSI",
    tech: "Master Plumber David (Truck #1)",
  },
];
---

<section class="py-14 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
  <div class="max-w-7xl mx-auto">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-600 mb-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Verified Local Activity Feed</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900">
          Recent Service Dispatches Across Denton, TX
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Real-time plumbing repairs and installations completed by our licensed technicians in Denton County:
        </p>
      </div>

      <div class="shrink-0">
        <a
          href={`tel:${siteConfig.phoneRaw}`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emergency-600 hover:bg-emergency-700 text-white font-bold text-xs sm:text-sm shadow transition"
        >
          <Icon name="phone" class="w-4 h-4 text-white" />
          <span>Dispatch a Truck to Your Street</span>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {recentJobs.map((job) => (
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 hover:border-brand-400 hover:bg-brand-50/20 transition shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
              <span class="font-bold text-slate-700 flex items-center gap-1">
                <Icon name="map-pin" class="w-3.5 h-3.5 text-slate-400" />
                <span>ZIP {job.zip}</span>
              </span>
              <span class="text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-md font-semibold flex items-center gap-1">
                <Icon name="clock" class="w-3 h-3 text-emerald-600" />
                <span>{job.time}</span>
              </span>
            </div>
            
            <h3 class="font-black text-slate-900 text-sm sm:text-base leading-snug mb-1">
              {job.location}
            </h3>
            
            <p class="text-xs text-brand-700 font-bold mb-3 flex items-center gap-1.5">
              <Icon name="wrench" class="w-3.5 h-3.5 text-brand-700" />
              <span>{job.service}</span>
            </p>
          </div>

          <div class="pt-3 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
            <span class="italic text-slate-600">{job.tech}</span>
            <span class="text-emerald-600 font-bold flex items-center gap-1">
              <Icon name="check" class="w-3.5 h-3.5 text-emerald-600 font-black" />
              <span>{job.status}</span>
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
