---
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';
---

<section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200 overflow-hidden">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    
    <!-- Left Fleet Story -->
    <div class="lg:col-span-6">
      <span class="text-xs font-black uppercase tracking-widest text-slate-500 block mb-1">
        THE FASTEST RESPONSE IN DENTON COUNTY
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-emergency-600 tracking-tight uppercase leading-tight mb-4">
        DENTON RAPID DISPATCH 911 FLEET
      </h2>
      <p class="text-base sm:text-lg font-bold text-slate-900 mb-4">
        When water is flooding your hardwood floors, every minute counts.
      </p>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6">
        Our service trucks function as <strong>mobile plumbing warehouses</strong>—stocked with over 1,200 OEM water heater valves, PEX piping coils, motorized snake cables, and high-pressure jetting tips. When our technician pulls into your driveway, we fix the problem immediately without leaving your home to hunt for parts.
      </p>

      <ul class="space-y-3 text-sm font-bold text-slate-800 mb-8">
        <li class="flex items-center gap-3">
          <span class="w-6 h-6 rounded-full bg-emergency-100 text-emergency-600 flex items-center justify-center text-xs">
            <Icon name="check" class="w-3.5 h-3.5" />
          </span>
          <span>Strategically staged along I-35E, I-35W &amp; Loop 288 corridors</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-6 h-6 rounded-full bg-emergency-100 text-emergency-600 flex items-center justify-center text-xs">
            <Icon name="check" class="w-3.5 h-3.5" />
          </span>
          <span>Live GPS technician tracking &amp; arrival notifications</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-6 h-6 rounded-full bg-emergency-100 text-emergency-600 flex items-center justify-center text-xs">
            <Icon name="check" class="w-3.5 h-3.5" />
          </span>
          <span>Zero after-hours or weekend emergency surcharge in Denton</span>
        </li>
      </ul>

      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-emergency-600 hover:bg-emergency-700 text-white font-black text-base shadow-xl transition transform hover:-translate-y-0.5"
      >
        <Icon name="phone" class="w-5 h-5 text-white" />
        <span>Dispatch A Technician Now: {siteConfig.phone}</span>
      </a>
    </div>

    <!-- Right Custom Fleet Graphic -->
    <div class="lg:col-span-6 flex justify-center">
      <div class="relative w-full max-w-lg">
        <div class="absolute inset-0 bg-gradient-to-r from-brand-500/10 to-emergency-500/10 rounded-3xl blur-2xl"></div>
        
        <div class="relative bg-slate-950 border-2 border-slate-800 rounded-3xl p-8 shadow-2xl text-white">
          <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-6">
            <div>
              <span class="text-xs text-slate-400 font-bold uppercase">Mobile Fleet Status</span>
              <h3 class="text-xl font-black text-white">Denton County On-Call Units</h3>
            </div>
            <span class="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-black uppercase animate-pulse">
              ● Active
            </span>
          </div>

          <div class="space-y-4 text-xs sm:text-sm">
            <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between">
              <div>
                <span class="font-black text-white">Unit #1 (Master Plumber David)</span>
                <span class="block text-slate-400 text-xs">Staged near Locust St &amp; University Dr</span>
              </div>
              <span class="text-emerald-400 font-bold">Available</span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between">
              <div>
                <span class="font-black text-white">Unit #2 (Lead Tech Aaron)</span>
                <span class="block text-slate-400 text-xs">Staged near Teasley Ln &amp; I-35E</span>
              </div>
              <span class="text-amber-400 font-bold">En Route</span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between">
              <div>
                <span class="font-black text-white">Unit #3 (Specialist Marcus)</span>
                <span class="block text-slate-400 text-xs">Staged near Rayzor Ranch &amp; US-380</span>
              </div>
              <span class="text-emerald-400 font-bold">Available</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
            <span>Average Dispatch Time: <strong class="text-white font-bold">28 Minutes</strong></span>
            <span class="text-emergency-400 font-bold">Call 24/7</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
