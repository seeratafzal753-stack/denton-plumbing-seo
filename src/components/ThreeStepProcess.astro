---
const steps = [
  {
    step: "Step 1",
    title: "Request Your Local Match",
    desc: "Call 24/7 or submit your request online. We connect you with an independent local plumbing specialist in your Denton neighborhood.",
  },
  {
    step: "Step 2",
    title: "Upfront Contractor Quote",
    desc: "Your matched plumbing contractor assesses the issue and provides a clear, upfront estimate before any work begins.",
  },
  {
    step: "Step 3",
    title: "Professional Completion",
    desc: "The contractor completes your repair or installation with professional-grade parts, restoring your water flow and peace of mind.",
  },
];
---

<section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-serif">
        How Our Referral Service Works
      </h2>
      <p class="text-slate-600 text-sm mt-2 max-w-xl mx-auto">
        A fast, seamless, and free way to connect with top local Denton plumbing professionals.
      </p>
      <div class="w-16 h-0.5 bg-brand-700 mx-auto mt-3"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {steps.map((s) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center shadow-sm hover:border-brand-600 hover:shadow-md transition">
          <span class="inline-block px-4 py-1.5 rounded-full bg-slate-100 text-slate-900 font-extrabold text-xs uppercase tracking-wider mb-4">
            {s.step}
          </span>
          <h3 class="text-lg font-bold text-slate-900 mb-3 font-serif">
            {s.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            {s.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
