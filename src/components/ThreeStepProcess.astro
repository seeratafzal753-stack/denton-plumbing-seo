---
const steps = [
  {
    step: "Step 1",
    title: "Schedule Your Dispatch",
    desc: "Call 24/7 or submit your request online. We assign the closest mobile unit staged near your Denton neighborhood.",
  },
  {
    step: "Step 2",
    title: "Upfront Diagnosis & Quote",
    desc: "Your licensed plumber performs an electronic inspection and provides an exact flat-rate price before any work begins.",
  },
  {
    step: "Step 3",
    title: "Flawless Repair & Warranty",
    desc: "We complete the repair using heavy-duty OEM parts, test all pressure/flow, and back it with our 100% satisfaction guarantee.",
  },
];
---

<section class="py-16 bg-slate-50 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-serif">
        With You, Every Step of the Way
      </h2>
      <p class="text-slate-600 text-sm mt-2 max-w-xl mx-auto">
        A seamless, stress-free plumbing experience from first call to final testing.
      </p>
      <div class="w-16 h-0.5 bg-brand-700 mx-auto mt-3"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {steps.map((s) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center shadow-sm hover:border-brand-600 hover:shadow-md transition">
          <span class="inline-block px-4 py-1.5 rounded-full bg-slate-100 text-slate-900 font-extrabold text-xs uppercase tracking-wider mb-4">
            {s.step}
          </span>
          <h3 class="text-lg font-bold text-slate-900 mb-3 font-serif">
            {s.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            {s.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
