---
import { siteConfig } from '../siteConfig';
import MascotBadge from './MascotBadge.astro';

const servicesList = [
  { name: 'Water Heater Repair', href: '/denton-tx/water-heater-repair/' },
  { name: '24/7 Emergency Plumbing', href: '/denton-tx/emergency-plumbing/' },
  { name: 'Drain Cleaning & Hydro-Jetting', href: '/denton-tx/drain-cleaning/' },
  { name: 'Slab Leak Detection & Reroutes', href: '/denton-tx/slab-leak-repair/' },
  { name: 'Tankless Water Heaters', href: '/denton-tx/tankless-water-heaters/' },
  { name: 'Sewer Line Repair & Relining', href: '/denton-tx/sewer-line-repair/' },
];

const citiesList = [
  { name: 'Denton, TX (Hub)', href: '/denton-tx/' },
  { name: 'Corinth, TX', href: '/service-areas/corinth-tx/' },
  { name: 'Argyle, TX', href: '/service-areas/argyle-tx/' },
  { name: 'Little Elm, TX', href: '/service-areas/little-elm-tx/' },
];
---

<footer class="bg-white text-slate-800 border-t-4 border-emergency-600">
  
  <!-- Dual Column Map & Contact Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Service Area Map Graphic -->
      <div class="lg:col-span-6 bg-slate-50 border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm">
        <span class="text-xs font-black uppercase tracking-widest text-slate-500 block mb-1">
          PROUDLY SERVING
        </span>
        <h3 class="text-2xl sm:text-3xl font-black text-emergency-600 tracking-tight uppercase mb-4">
          GREATER DENTON AREA
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 mb-6">
          Stationed throughout Denton County along the I-35E, I-35W, and Loop 288 corridors for rapid 28–35 minute dispatch.
        </p>

        <!-- Vector Illustrated Coverage Map Graphic -->
        <div class="relative w-full aspect-[16/10] bg-slate-900 rounded-2xl border border-slate-700 overflow-hidden p-4 flex items-center justify-center text-white shadow-inner">
          <div class="absolute inset-0 opacity-25 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:16px_16px]"></div>
          
          <!-- Illustrated Denton County Polygon -->
          <svg class="w-full h-full" viewBox="0 0 400 250" fill="none">
            <!-- County boundary -->
            <polygon points="40,30 360,20 370,220 30,230" fill="#1e3a8a" fill-opacity="0.4" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4 2"/>
            
            <!-- Lake Lewisville Vector Silhouette -->
            <path d="M220 120 C240 140 280 150 260 190 C240 210 200 180 220 120 Z" fill="#0284c7" fill-opacity="0.8"/>
            <text x="230" y="165" fill="#ffffff" font-size="10" font-weight="700">Lake Lewisville</text>

            <!-- Lake Ray Roberts Vector Silhouette -->
            <path d="M150 35 C180 40 190 75 160 85 C140 75 130 50 150 35 Z" fill="#0284c7" fill-opacity="0.8"/>
            <text x="145" y="60" fill="#ffffff" font-size="9" font-weight="700">Ray Roberts</text>

            <!-- Denton City Pin (Center) -->
            <circle cx="170" cy="125" r="8" fill="#dc2626"/>
            <circle cx="170" cy="125" r="16" fill="#dc2626" fill-opacity="0.3" class="animate-ping"/>
            <text x="170" y="145" fill="#ffffff" font-size="12" font-weight="900" text-anchor="middle">DENTON (76201)</text>

            <!-- Surrounding Towns Pins -->
            <circle cx="210" cy="165" r="5" fill="#f59e0b"/>
            <text x="218" y="168" fill="#e2e8f0" font-size="10" font-weight="600">Corinth</text>

            <circle cx="120" cy="180" r="5" fill="#f59e0b"/>
            <text x="75" y="183" fill="#e2e8f0" font-size="10" font-weight="600">Argyle</text>

            <circle cx="290" cy="175" r="5" fill="#f59e0b"/>
            <text x="298" y="178" fill="#e2e8f0" font-size="10" font-weight="600">Little Elm</text>

            <circle cx="150" cy="40" r="5" fill="#f59e0b"/>
            <text x="105" y="43" fill="#e2e8f0" font-size="10" font-weight="600">Sanger</text>
          </svg>
        </div>

        <div class="mt-4 flex flex-wrap gap-2 text-xs">
          {citiesList.map((c) => (
            <a href={c.href} class="px-3 py-1 bg-white border border-slate-300 rounded-lg font-bold text-slate-700 hover:border-emergency-600 hover:text-emergency-600 transition">
              📍 {c.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Right Column: Quick Contact Matrix & Mascot -->
      <div class="lg:col-span-6 flex flex-col justify-between h-full">
        <div>
          <span class="text-xs font-black uppercase tracking-widest text-slate-500 block mb-1">
            FOR ALL OF YOUR RESIDENTIAL & COMMERCIAL
          </span>
          <h3 class="text-2xl sm:text-3xl font-black text-emergency-600 tracking-tight uppercase mb-6">
            PLUMBING PROBLEMS?
          </h3>

          <!-- 3 Quick Action Pill Buttons -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
            <a
              href={`tel:${siteConfig.phoneRaw}`}
              class="py-3.5 px-4 rounded-xl bg-brand-800 hover:bg-brand-900 text-white font-black text-xs sm:text-sm text-center shadow transition flex items-center justify-center gap-1.5"
            >
              <span>📞</span>
              <span>(940) 310-4499</span>
            </a>

            <a
              href="/contact/"
              class="py-3.5 px-4 rounded-xl bg-emergency-600 hover:bg-emergency-700 text-white font-black text-xs sm:text-sm text-center shadow transition flex items-center justify-center gap-1.5"
            >
              <span>⚡</span>
              <span>BOOK ONLINE</span>
            </a>

            <a
              href="#estimate-form"
              class="py-3.5 px-4 rounded-xl bg-slate-900 hover:bg-black text-white font-black text-xs sm:text-sm text-center shadow transition flex items-center justify-center gap-1.5"
            >
              <span>⭐</span>
              <span>SPECIALS</span>
            </a>
          </div>

          <!-- Address & Hours Information -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 p-6 rounded-2xl bg-slate-50 border border-slate-200 mb-8 text-xs sm:text-sm text-slate-700">
            <div>
              <span class="block font-black text-slate-900 uppercase text-xs mb-1">Local Dispatch Hub:</span>
              <p class="leading-relaxed">
                {siteConfig.nap.address}<br />
                {siteConfig.nap.city}, {siteConfig.nap.state} {siteConfig.nap.zip}
              </p>
              <span class="block text-slate-500 text-xs mt-2">
                TSBPE Master Plumber #M-42918
              </span>
            </div>

            <div>
              <span class="block font-black text-slate-900 uppercase text-xs mb-1">Operating Hours:</span>
              <p class="leading-relaxed font-bold text-emerald-700">
                ● 24/7 Emergency Dispatch<br />
                Monday – Sunday: Open 24 Hours<br />
                <span class="text-slate-500 font-normal">Holidays & Weekends Included</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Mascot & Logo Signature -->
        <div class="flex items-center justify-between pt-6 border-t border-slate-200">
          <div class="flex items-center gap-3">
            <MascotBadge size="sm" />
            <div>
              <span class="block font-black text-lg text-slate-900 leading-tight">
                Denton<span class="text-emergency-600">Plumbing</span>Pros
              </span>
              <span class="block text-xs font-bold text-slate-500">
                Texas Pride • Honest Master Plumbers
              </span>
            </div>
          </div>

          <a
            href={`tel:${siteConfig.phoneRaw}`}
            class="hidden sm:inline-flex px-4 py-2 rounded-xl bg-emergency-600 text-white font-black text-xs shadow hover:bg-emergency-700 transition"
          >
            Call {siteConfig.phone}
          </a>
        </div>

      </div>

    </div>
  </div>

  <!-- Bottom Legal Bar -->
  <div class="bg-slate-950 text-slate-400 text-xs py-5 px-4 border-t border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <p>
        © {new Date().getFullYear()} Denton Plumbing Pros. All rights reserved. Regulated by the Texas State Board of Plumbing Examiners (TSBPE).
      </p>
      <div class="flex space-x-4">
        <a href="/robots.txt" class="hover:text-white transition">Robots.txt</a>
        <a href="/sitemap-index.xml" class="hover:text-white transition">Sitemap</a>
        <a href="/contact/" class="hover:text-white transition">Privacy & Terms</a>
      </div>
    </div>
  </div>

</footer>
