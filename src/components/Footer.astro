---
import { siteConfig } from '../siteConfig';

const currentYear = new Date().getFullYear();

const coreServices = [
  { name: 'Emergency Plumbing Denton', href: '/denton-tx/emergency-plumbing/' },
  { name: 'Water Heater Repair & Install', href: '/denton-tx/water-heater-repair/' },
  { name: 'Tankless Water Heaters', href: '/denton-tx/tankless-water-heaters/' },
  { name: 'Drain Cleaning & Hydro Jetting', href: '/denton-tx/drain-cleaning/' },
  { name: 'Slab Leak Detection & Repair', href: '/denton-tx/slab-leak-repair/' },
  { name: 'Sewer Line Repair & Replacement', href: '/denton-tx/sewer-line-repair/' },
  { name: 'Gas Line Plumbing & Repair', href: '/denton-tx/gas-line-repair/' },
];

const surroundingCities = siteConfig.serviceAreas;
---

<footer class="bg-slate-950 text-slate-300 pt-16 pb-24 lg:pb-16 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Brand & NAP Column -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded bg-brand-500 text-white font-black flex items-center justify-center">
            DP
          </div>
          <span class="text-xl font-bold text-white tracking-tight">Denton Plumbing Pros</span>
        </div>
        <p class="text-sm text-slate-400 mb-6 leading-relaxed">
          Trusted, licensed, and insured plumbing contractors serving Denton, TX and surrounding North Texas communities 24 hours a day, 7 days a week.
        </p>
        <div class="space-y-2 text-sm">
          <p class="flex items-center gap-2">
            <span class="text-amber-400">📞 Phone:</span>
            <a href={`tel:${siteConfig.phoneRaw}`} class="font-bold text-white hover:text-amber-400 transition">
              {siteConfig.phone}
            </a>
          </p>
          <p class="text-slate-400">
            <span class="text-slate-300">📍 Primary Hub:</span> Denton, TX {siteConfig.postalCode}
          </p>
          <p class="text-slate-400">
            <span class="text-slate-300">🕒 Hours:</span> 24/7 Emergency Dispatch
          </p>
        </div>
      </div>

      <!-- Money Services Silo Links -->
      <div>
        <h3 class="text-white text-base font-bold uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Denton Plumbing Services
        </h3>
        <ul class="space-y-2 text-sm">
          {coreServices.map((service) => (
            <li>
              <a href={service.href} class="hover:text-brand-400 hover:underline transition">
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Surrounding Service Areas Silo Links -->
      <div>
        <h3 class="text-white text-base font-bold uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Areas We Serve
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/denton-tx/" class="text-brand-400 font-semibold hover:underline">
              → Denton, TX (Primary City Hub)
            </a>
          </li>
          {surroundingCities.map((city) => (
            <li>
              <a href={`/service-areas/${city.slug}/`} class="hover:text-brand-400 hover:underline transition">
                Plumber in {city.name}, TX
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Denton Neighborhoods & ZIP Codes Local Cloud -->
      <div>
        <h3 class="text-white text-base font-bold uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Denton Neighborhoods & ZIPs
        </h3>
        <p class="text-xs text-slate-400 mb-3">
          Same-day mobile dispatch across all Denton residential & commercial zones:
        </p>
        <div class="flex flex-wrap gap-1.5 mb-4">
          {siteConfig.neighborhoods.map((n) => (
            <span class="text-xs bg-slate-900 border border-slate-800 text-slate-300 px-2 py-0.5 rounded">
              {n}
            </span>
          ))}
        </div>
        <div class="text-xs text-slate-400">
          <strong>ZIP Codes:</strong> {siteConfig.zipCodes.join(', ')}
        </div>
      </div>

    </div>

    <!-- Bottom Legal & Disclaimer Bar -->
    <div class="mt-12 pt-8 border-t border-slate-800 text-center md:flex md:justify-between items-center text-xs text-slate-400">
      <p>© {currentYear} {siteConfig.name}. All rights reserved. Texas Master Plumber Affiliated Network.</p>
      <div class="mt-4 md:mt-0 space-x-4">
        <a href="/privacy-policy/" class="hover:underline">Privacy Policy</a>
        <a href="/terms/" class="hover:underline">Terms of Service</a>
        <a href="/sitemap-index.xml" class="hover:underline">XML Sitemap</a>
      </div>
    </div>
  </div>
</footer>
