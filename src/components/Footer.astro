---
import { siteConfig } from '../siteConfig';

const servicesList = [
  { name: 'Water Heater Repair & Replacement', href: '/denton-tx/water-heater-repair/' },
  { name: '24/7 Emergency Plumbing', href: '/denton-tx/emergency-plumbing/' },
  { name: 'Drain Cleaning & Hydro-Jetting', href: '/denton-tx/drain-cleaning/' },
  { name: 'Slab Leak Detection & Reroutes', href: '/denton-tx/slab-leak-repair/' },
  { name: 'Tankless Water Heaters', href: '/denton-tx/tankless-water-heaters/' },
  { name: 'Sewer Line Repair & Relining', href: '/denton-tx/sewer-line-repair/' },
];

const citiesList = [
  { name: 'Denton, TX (Primary Hub)', href: '/denton-tx/' },
  { name: 'Corinth, TX', href: '/service-areas/corinth-tx/' },
  { name: 'Argyle, TX', href: '/service-areas/argyle-tx/' },
  { name: 'Little Elm, TX', href: '/service-areas/little-elm-tx/' },
];
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Col 1: Brand & Credentials -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-center p-2 shadow">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C8.5 6.5 5 11 5 15C5 18.866 8.134 22 12 22C15.866 22 19 18.866 19 15C19 11 15.5 6.5 12 2Z" fill="#0284c7" fill-opacity="0.25" stroke="#38bdf8" stroke-width="1.5"/>
              <path d="M17.5 7.5L14 11L12.5 9.5L16 6C16.8 5.2 18.1 5.2 18.9 6C19.7 6.8 19.7 8.1 18.9 8.9L17.5 7.5Z" fill="#ef4444"/>
              <path d="M8 17L12.5 12.5L11 11L6.5 15.5C5.8 16.2 5.8 17.3 6.5 18C7.2 18.7 8.3 18.7 9 18L8 17Z" fill="#ffffff"/>
            </svg>
          </div>
          <span class="font-black text-lg text-white">
            Denton<span class="text-brand-400">Plumbing</span><span class="text-red-500">Pros</span>
          </span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed mb-4">
          Licensed, insured, and locally dispatched master plumbing services engineered for Denton County's unique water mineralogy and clay sub-soils.
        </p>
        <div class="text-xs text-slate-400 space-y-1">
          <p><strong class="text-white">TSBPE License:</strong> Master Plumber #M-42918</p>
          <p><strong class="text-white">Insurance:</strong> $2M General Commercial Liability</p>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h4 class="font-bold text-white text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Plumbing Services
        </h4>
        <ul class="space-y-2 text-xs">
          {servicesList.map((s) => (
            <li>
              <a href={s.href} class="text-slate-400 hover:text-white transition">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Service Areas -->
      <div>
        <h4 class="font-bold text-white text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Coverage Areas
        </h4>
        <ul class="space-y-2 text-xs">
          {citiesList.map((c) => (
            <li>
              <a href={c.href} class="text-slate-400 hover:text-white transition">
                {c.name}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 pt-4 border-t border-slate-800">
          <span class="block text-xs font-semibold text-slate-300 mb-1">Serving Denton ZIPs:</span>
          <p class="text-[11px] text-slate-400 leading-relaxed">
            76201, 76205, 76207, 76208, 76209, 76210, 76226, 76249
          </p>
        </div>
      </div>

      <!-- Col 4: Contact & Hours -->
      <div>
        <h4 class="font-bold text-white text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Contact & Dispatch
        </h4>
        <div class="space-y-3 text-xs">
          <div>
            <span class="block text-slate-400 text-[11px]">24/7 Phone Line:</span>
            <a href={`tel:${siteConfig.phoneRaw}`} class="text-base font-bold text-amber-400 hover:underline">
              {siteConfig.phone}
            </a>
          </div>
          <div>
            <span class="block text-slate-400 text-[11px]">Physical Address:</span>
            <p class="text-slate-300">
              {siteConfig.nap.address}<br />
              {siteConfig.nap.city}, {siteConfig.nap.state} {siteConfig.nap.zip}
            </p>
          </div>
          <div>
            <span class="block text-slate-400 text-[11px]">Operating Hours:</span>
            <p class="text-emerald-400 font-semibold">
              ● Open 24 Hours / 7 Days a Week
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Legal Bar -->
  <div class="bg-slate-950 text-slate-500 text-xs py-5 px-4 border-t border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <p>
        © {new Date().getFullYear()} Denton Plumbing Pros. All rights reserved. Regulated by the Texas State Board of Plumbing Examiners (TSBPE).
      </p>
      <div class="flex space-x-6 text-slate-400">
        <a href="/robots.txt" class="hover:text-white transition">Robots.txt</a>
        <a href="/sitemap-index.xml" class="hover:text-white transition">Sitemap</a>
        <a href="/contact/" class="hover:text-white transition">Privacy & Terms</a>
      </div>
    </div>
  </div>

</footer>
