    icon: `<svg class="w-12 h-12 mx-auto stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12a7.5 7.5 0 0015 0m-15 0H3m16.5 0H21m-9-9v3m0 0a3 3 0 013 3v1.5H9V9a3 3 0 013-3zM8.25 16.5l.75 1.5m6-1.5l-.75 1.5m-3-1.5v2.25"/></svg>`,
  },
  {
    title: "FAUCETS",
    subtitle: "& FIXTURES",
    href: "/denton-tx/water-heater-repair/",
    icon: `<svg class="w-12 h-12 mx-auto stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75v4.5m11.25-4.5H4.5m15 0a2.25 2.25 0 002.25-2.25v-1.5a2.25 2.25 0 00-2.25-2.25h-.75"/></svg>`,
  },
  {
    title: "GAS & SEWER",
    subtitle: "EMERGENCY REPAIR",
    href: "/denton-tx/sewer-line-repair/",
    icon: `<svg class="w-12 h-12 mx-auto stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>`,
  },
];
---

<section class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200 relative">
  <!-- Subtle Blueprint Texture Background -->
  <div class="absolute inset-0 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:16px_16px] opacity-60 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-black uppercase tracking-widest text-slate-500 block mb-1">
        PROFESSIONAL PLUMBING SERVICES
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-emergency-600 tracking-tight uppercase">
        IN DENTON & SURROUNDING CITIES
      </h2>
      <div class="w-20 h-1 bg-emergency-600 mx-auto mt-3 rounded-full"></div>
    </div>

    <!-- 10-Item 5x2 Responsive Icon Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6 sm:gap-8">
      {iconServices.map((s) => (
        <a
          href={s.href}
          class="group p-5 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-xl hover:border-emergency-600 transition-all duration-300 transform hover:-translate-y-1 text-center flex flex-col items-center justify-center"
        >
          <div class="text-slate-800 group-hover:text-emergency-600 transition duration-300 mb-3" set:html={s.icon} />
          
          <h3 class="font-black text-slate-900 text-sm sm:text-base group-hover:text-emergency-600 transition leading-tight">
            {s.title}
          </h3>
          <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mt-0.5">
            {s.subtitle}
          </span>
        </a>
      ))}
    </div>

    <!-- Bottom Quick Link -->
    <div class="mt-10 text-center">
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="inline-flex items-center gap-2 text-sm font-black text-slate-800 hover:text-emergency-600 transition"
      >
        <span>Don't see your specific problem? Call our 24/7 Denton Master Plumber dispatch:</span>
        <span class="text-emergency-600 underline font-black">{siteConfig.phone}</span>
        <span>→</span>
      </a>
    </div>

  </div>
</section>
