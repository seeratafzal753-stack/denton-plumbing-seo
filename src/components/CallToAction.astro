---
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';

interface Props {
  heading?: string;
  subheading?: string;
  buttonText?: string;
  emergency?: boolean;
}

const {
  heading = "Need a Fast, Reliable Plumber in Denton, TX?",
  subheading = "Don't let a leak or broken water heater ruin your home. Connect with trusted independent local plumbing specialists for fast assistance.",
  buttonText = "Call (940) 310-4499 for Referral",
  emergency = true,
} = Astro.props;
---

<section class={`py-16 px-4 sm:px-6 lg:px-8 text-white relative overflow-hidden ${emergency ? 'bg-gradient-to-br from-slate-900 via-brand-900 to-slate-950' : 'bg-brand-700'}`}>
  <div class="max-w-5xl mx-auto text-center relative z-10">
    <div class="inline-flex items-center gap-2 bg-emergency-600/90 text-white text-xs uppercase font-bold tracking-widest px-3 py-1 rounded-full mb-4">
      <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
      <span>24/7 Denton County Referral Ready</span>
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 leading-tight font-serif">
      {heading}
    </h2>
    <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto mb-8 leading-relaxed">
      {subheading}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-emergency-600 hover:bg-emergency-500 text-white font-black text-lg shadow-2xl transition transform hover:-translate-y-1"
      >
        <Icon name="phone" class="w-6 h-6 text-white" />
        <span>{buttonText}</span>
      </a>

      <a
        href="/contact/"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base backdrop-blur-sm border border-white/20 transition"
      >
        <span>Request Estimate Online</span>
      </a>
    </div>

    <div class="mt-8 flex flex-wrap justify-center items-center gap-6 text-xs text-slate-400">
      <span class="flex items-center gap-1.5">
        <Icon name="check" class="w-3.5 h-3.5 text-emerald-400" />
        <span>Fast Local Matching</span>
      </span>
      <span class="flex items-center gap-1.5">
        <Icon name="check" class="w-3.5 h-3.5 text-emerald-400" />
        <span>Upfront Estimates</span>
      </span>
      <span class="flex items-center gap-1.5">
        <Icon name="check" class="w-3.5 h-3.5 text-emerald-400" />
        <span>Independent Local Specialists</span>
      </span>
      <span class="flex items-center gap-1.5">
        <Icon name="check" class="w-3.5 h-3.5 text-emerald-400" />
        <span>Serving All Denton ZIPs</span>
      </span>
    </div>
  </div>
</section>
