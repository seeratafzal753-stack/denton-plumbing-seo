---
import { siteConfig } from '../siteConfig';
import Icon from './Icon.astro';

interface Props {
  heading?: string;
  subheading?: string;
  buttonText?: string;
}

const {
  heading = "Need a Fast, Reliable Plumber in Denton, TX?",
  subheading = "Don't let a leak or broken water heater ruin your home. Connect with trusted independent local plumbing specialists for fast assistance.",
  buttonText = `Call ${siteConfig.phone} for Referral`,
} = Astro.props;
---

<section class="py-16 px-4 sm:px-6 lg:px-8 text-white relative overflow-hidden bg-gradient-to-r from-[#1c0303] via-[#450a0a] to-[#180202] border-t border-[#5c0d0d] shadow-inner">
  <div class="max-w-5xl mx-auto text-center relative z-10">
    <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md text-red-200 border border-red-400/30 text-xs uppercase font-extrabold tracking-widest px-3.5 py-1.5 rounded-full mb-4 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
      <span>24/7 Denton County Referral Ready</span>
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-4 leading-tight font-serif text-white">
      {heading}
    </h2>
    <p class="text-base sm:text-lg text-slate-200 max-w-3xl mx-auto mb-8 leading-relaxed font-normal">
      {subheading}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-[#c8102e] hover:bg-[#a60c24] text-white font-black text-base uppercase tracking-wider shadow-2xl transition transform hover:-translate-y-0.5 border border-red-400/30 cursor-pointer"
      >
        <Icon name="phone" class="w-5 h-5 text-white" />
        <span>{buttonText}</span>
      </a>

      <a
        href="#estimate-form"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full bg-[#1a2b4c] hover:bg-[#121e35] text-white font-black text-base uppercase tracking-wider shadow-xl transition transform hover:-translate-y-0.5 border border-sky-400/20 cursor-pointer"
      >
        <span>Request a Local Pro</span>
      </a>
    </div>

    <div class="mt-8 flex flex-wrap justify-center items-center gap-6 text-xs text-slate-300">
      <span class="flex items-center gap-1.5">
        <Icon name="check" class="w-3.5 h-3.5 text-emerald-400 font-bold" />
        <span>Fast Local Matching</span>
      </span>
      <span class="flex items-center gap-1.5">
        <Icon name="check" class="w-3.5 h-3.5 text-emerald-400 font-bold" />
        <span>Upfront Estimates</span>
      </span>
      <span class="flex items-center gap-1.5">
        <Icon name="check" class="w-3.5 h-3.5 text-emerald-400 font-bold" />
        <span>Independent Local Specialists</span>
      </span>
      <span class="flex items-center gap-1.5">
        <Icon name="check" class="w-3.5 h-3.5 text-emerald-400 font-bold" />
        <span>100% Free Referral</span>
      </span>
    </div>
  </div>
</section>
