---
---

<div class="relative w-full max-w-lg lg:max-w-xl mx-auto flex items-center justify-center py-1">
  
  <!-- Subtle Soft Ambient Glow Backdrop -->
  <div class="absolute inset-0 bg-gradient-to-tr from-sky-400/20 via-blue-600/10 to-transparent rounded-3xl blur-2xl transform scale-105 pointer-events-none"></div>

  <!-- Main Professional Branded Photo Card (Zero Floating Badge Overlap) -->
  <div class="relative z-10 w-full rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 bg-white group">
    
    <!-- Real Branded Texas Plumber Technician & Service Vehicle Photo -->
    <img
      src="/images/professional-plumber.jpg"
      alt="Local Denton Plumbing Specialist and Service Vehicle in Denton, TX"
      class="w-full h-auto max-h-[420px] sm:max-h-[460px] object-cover object-center transform group-hover:scale-[1.01] transition-transform duration-500"
      width="800"
      height="600"
      loading="eager"
    />

    <!-- Clean Bottom Gradient Caption -->
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/80 via-slate-900/30 to-transparent p-4 sm:p-5 flex items-center justify-between text-white">
      <div>
        <span class="block text-xs sm:text-sm font-black text-white leading-tight flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Denton Local Plumbing Network</span>
        </span>
        <span class="block text-[11px] text-slate-300 font-medium mt-0.5">
          Connecting Homeowners with Local Plumbing Specialists
        </span>
      </div>
      <span class="hidden sm:inline-block px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-white border border-white/30">
        24/7 Match
      </span>
    </div>

  </div>

</div>
