---
---

<div class="relative w-full max-w-lg lg:max-w-xl mx-auto flex items-center justify-center py-2">
  
  <!-- Subtle Soft Ambient Gradient Backdrop -->
  <div class="absolute inset-0 bg-gradient-to-tr from-sky-400/20 via-blue-600/10 to-transparent rounded-3xl blur-2xl transform scale-105 pointer-events-none"></div>

  <!-- Main Professional Real-Plumber Photo Card -->
  <div class="relative z-10 w-full rounded-3xl overflow-hidden shadow-2xl border-2 border-slate-200/80 bg-white group">
    
    <!-- Real Texas Master Plumber Technician & Service Vehicle Photo -->
    <img
      src="/images/professional-plumber.jpg"
      alt="Certified Texas Master Plumber with Emergency Response Service Truck in Denton, TX"
      class="w-full h-auto max-h-[420px] sm:max-h-[460px] object-cover object-center transform group-hover:scale-[1.02] transition-transform duration-500"
      width="800"
      height="600"
      loading="eager"
    />

    <!-- Subtle Clean Gradient Overlay at Bottom of Photo -->
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/85 via-slate-900/40 to-transparent p-4 sm:p-5 flex items-center justify-between text-white">
      <div>
        <span class="block text-xs sm:text-sm font-black text-white leading-tight flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Denton County Master Technician On Duty</span>
        </span>
        <span class="block text-[11px] text-slate-300 font-medium mt-0.5">
          Fully Stocked Mobile Dispatch Units
        </span>
      </div>
      <span class="hidden sm:inline-block px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-white border border-white/30">
        Licensed &amp; Insured
      </span>
    </div>

  </div>

  <!-- Floating Clean Trust Badge 1: Top-Right (No overlap with content) -->
  <div class="absolute -top-3 -right-2 sm:-right-4 bg-white/95 backdrop-blur-md border border-slate-200 shadow-xl rounded-2xl p-2.5 sm:p-3 flex items-center gap-2.5 z-20 transition-transform hover:scale-105">
    <div class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center text-base font-black shadow-sm shrink-0">
      <span>🛡️</span>
    </div>
    <div>
      <span class="block text-[11px] sm:text-xs font-black text-slate-900 leading-none">TSBPE Master Plumber</span>
      <span class="block text-[9px] text-slate-500 font-bold uppercase mt-1">License #M-42918</span>
    </div>
  </div>

  <!-- Floating Clean Trust Badge 2: Bottom-Left (Clean floating card) -->
  <div class="absolute -bottom-3 -left-2 sm:-left-4 bg-white/95 backdrop-blur-md border border-slate-200 shadow-xl rounded-2xl p-2.5 sm:p-3 flex items-center gap-2.5 z-20 transition-transform hover:scale-105">
    <div class="w-9 h-9 rounded-xl bg-red-50 text-red-600 border border-red-200/80 flex items-center justify-center text-base font-black shadow-sm shrink-0">
      <span>⚡</span>
    </div>
    <div>
      <span class="block text-[11px] sm:text-xs font-black text-slate-900 leading-none">28-Min Local Dispatch</span>
      <span class="block text-[9px] text-slate-500 font-bold uppercase mt-1">Denton County Wide</span>
    </div>
  </div>

</div>
