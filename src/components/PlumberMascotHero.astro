---

<div class="relative w-full max-w-lg mx-auto lg:max-w-none flex items-center justify-center py-2 lg:py-6">
  
  <!-- Subtle Light-Blue Ambient Radial Glow & Water Ring Geometry -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <!-- Soft outer glow -->
    <div class="w-[340px] sm:w-[440px] lg:w-[480px] h-[340px] sm:h-[440px] lg:h-[480px] rounded-full bg-gradient-to-tr from-sky-200/40 via-blue-100/30 to-transparent blur-2xl"></div>
    
    <!-- Concentric subtle decorative water/pipe rings -->
    <div class="absolute w-[300px] sm:w-[380px] lg:w-[430px] h-[300px] sm:h-[380px] lg:h-[430px] rounded-full border border-sky-200/50"></div>
    <div class="absolute w-[220px] sm:w-[300px] lg:w-[340px] h-[220px] sm:h-[300px] lg:h-[340px] rounded-full border border-sky-100/70 bg-gradient-to-b from-sky-50/40 to-white/30 shadow-inner"></div>
  </div>

  <!-- Floating Trust Card 1: Certified Texas Master Plumber -->
  <div class="absolute top-4 -left-2 sm:left-2 bg-white/95 backdrop-blur-md border border-slate-200 shadow-xl rounded-2xl p-3 sm:p-3.5 flex items-center gap-3 z-20 transition-transform hover:scale-105 hidden sm:flex">
    <div class="w-10 h-10 rounded-xl bg-slate-900 flex items-center justify-center text-white text-lg font-black shadow-sm">
      <span>🛡️</span>
    </div>
    <div>
      <span class="block text-xs font-black text-slate-900 leading-none">Texas Master Plumber</span>
      <span class="block text-[10px] text-slate-500 font-bold uppercase mt-1">TSBPE License #M-42918</span>
    </div>
  </div>

  <!-- Floating Trust Card 2: 24/7 Rapid Emergency Response -->
  <div class="absolute bottom-6 -right-2 sm:right-2 bg-white/95 backdrop-blur-md border border-slate-200 shadow-xl rounded-2xl p-3 sm:p-3.5 flex items-center gap-3 z-20 transition-transform hover:scale-105 hidden sm:flex">
    <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center text-lg font-black border border-red-200/80 shadow-sm">
      <span>⚡</span>
    </div>
    <div>
      <span class="block text-xs font-black text-slate-900 leading-none">28-Min Local Dispatch</span>
      <span class="block text-[10px] text-slate-500 font-bold uppercase mt-1">Serving All Denton ZIPs</span>
    </div>
  </div>

  <!-- Grounding Shadow -->
  <div class="absolute bottom-2 sm:bottom-4 w-64 sm:w-80 h-8 sm:h-10 bg-slate-900/10 rounded-full blur-lg pointer-events-none"></div>

  <!-- Upgraded Master Plumber Visual Presentation -->
  <div class="relative z-10 p-2">
    <img
      src="/images/plumber-mascot.png"
      alt="Denton Licensed Master Plumber"
      class="w-auto h-[360px] sm:h-[440px] lg:h-[500px] max-w-full object-contain drop-shadow-xl hover:scale-[1.01] transition-transform duration-300"
      width="500"
      height="750"
      loading="eager"
    />
  </div>

</div>
