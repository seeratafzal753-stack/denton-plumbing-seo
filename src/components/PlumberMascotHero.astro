---
---

<div class="relative w-full max-w-lg mx-auto lg:max-w-none flex items-center justify-center py-2 lg:py-6">
  
  <!-- Subtle Light-Blue Ambient Circular Glow & Water Ripple Rings -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <!-- Soft outer radial glow -->
    <div class="w-[340px] sm:w-[440px] lg:w-[480px] h-[340px] sm:h-[440px] lg:h-[480px] rounded-full bg-gradient-to-tr from-sky-200/50 via-blue-100/40 to-transparent blur-2xl"></div>
    
    <!-- Concentric subtle decorative water/pipe rings -->
    <div class="absolute w-[300px] sm:w-[380px] lg:w-[430px] h-[300px] sm:h-[380px] lg:h-[430px] rounded-full border border-sky-200/60"></div>
    <div class="absolute w-[220px] sm:w-[300px] lg:w-[340px] h-[220px] sm:h-[300px] lg:h-[340px] rounded-full border border-sky-100/80 bg-gradient-to-b from-sky-50/50 to-white/40 shadow-inner"></div>
    
    <!-- Minimal decorative plumbing curve line (subtle SVG) -->
    <svg class="absolute w-[320px] sm:w-[420px] h-[320px] sm:h-[420px] text-sky-200/40" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 3">
      <circle cx="50" cy="50" r="46" />
      <path d="M 50 4 A 46 46 0 0 1 96 50" stroke-width="1.2" stroke-dasharray="none" class="text-sky-300/50" />
    </svg>
  </div>

  <!-- Soft Grounding Shadow beneath mascot boots & pipe -->
  <div class="absolute bottom-2 sm:bottom-4 w-64 sm:w-80 h-8 sm:h-10 bg-slate-900/10 rounded-full blur-lg pointer-events-none"></div>

  <!-- Cartoon Plumber Mascot (Preserved exact mascot, transparent background, natural proportion) -->
  <img
    src="/images/plumber-mascot.png"
    alt="Denton Plumbing Pros Mascot"
    class="w-auto h-[380px] sm:h-[460px] lg:h-[520px] max-w-full object-contain relative z-10 drop-shadow-xl hover:scale-[1.01] transition-transform duration-300"
    width="500"
    height="750"
    loading="eager"
  />

</div>

