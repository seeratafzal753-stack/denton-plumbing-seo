---
---

<div class="relative w-full max-w-lg mx-auto lg:max-w-none flex items-center justify-center py-4">
  
  <!-- Integrated Multi-Layer Glow / Ring Backdrop (Eliminates raw empty white feeling) -->
  <div class="absolute inset-0 bg-gradient-to-tr from-brand-600/15 via-blue-500/10 to-red-500/10 rounded-full blur-3xl transform scale-110 pointer-events-none"></div>
  <div class="absolute w-72 sm:w-96 h-72 sm:h-96 rounded-full bg-gradient-to-br from-blue-50 to-slate-100 border border-slate-200/80 shadow-inner pointer-events-none"></div>
  <div class="absolute -bottom-2 w-3/4 h-12 bg-slate-900/15 rounded-full blur-xl pointer-events-none"></div>
  
  <!-- Floating Trust Badge Left -->
  <div class="absolute top-8 -left-2 sm:left-0 bg-white/95 backdrop-blur-md border border-slate-200 shadow-xl rounded-2xl p-3 flex items-center gap-2.5 z-20 animate-bounce duration-1000 hidden sm:flex">
    <span class="text-xl">⚡</span>
    <div>
      <span class="block text-[11px] font-black text-slate-900 leading-none">28-Min Fast Arrival</span>
      <span class="block text-[9px] text-slate-500 font-bold uppercase mt-0.5">Denton County Wide</span>
    </div>
  </div>

  <!-- Floating Trust Badge Right -->
  <div class="absolute bottom-12 -right-2 sm:right-0 bg-white/95 backdrop-blur-md border border-slate-200 shadow-xl rounded-2xl p-3 flex items-center gap-2.5 z-20 hidden sm:flex">
    <span class="text-xl text-red-600 font-black">⭐</span>
    <div>
      <span class="block text-[11px] font-black text-slate-900 leading-none">100% Upfront Pricing</span>
      <span class="block text-[9px] text-slate-500 font-bold uppercase mt-0.5">Zero Hidden Overtime</span>
    </div>
  </div>

  <!-- User Uploaded Cartoon Plumber Mascot Picture -->
  <img
    src="/images/plumber-mascot.png"
    alt="Denton Master Plumber Mascot"
    class="w-auto h-[380px] sm:h-[460px] lg:h-[500px] max-w-full object-contain relative z-10 drop-shadow-2xl hover:scale-[1.02] transition-transform duration-300"
    width="500"
    height="750"
    loading="eager"
  />

</div>
