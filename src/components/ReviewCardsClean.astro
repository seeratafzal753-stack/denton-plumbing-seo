---
import Icon from './Icon.astro';

const reviews = [
  {
    title: "Fast Sunday Night Water Heater Replacement",
    text: "Our water heater started leaking on a Sunday evening. We called and were quickly connected with a local plumbing professional in Denton who gave an upfront price and replaced the unit. Fast and painless process!",
    author: "Marcus & Kimberly T.",
    location: "Teasley Ln, Southridge (Denton, TX)",
  },
  {
    title: "Slab Leak Diagnosis & Clean PEX Reroute",
    text: "We noticed warm spots on our flooring and called for help. The matched local specialist inspected the lines electronically, pin-pointed the leak location, and routed a new line cleanly through the attic. Very helpful service.",
    author: "Robert & Sarah G.",
    location: "Nottingham Dr, Idiots Hill (Denton, TX)",
  },
];
---

<section id="reviews" class="py-16 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-serif">
        Homeowner Feedback &amp; Experiences
      </h2>
      <p class="text-slate-600 text-sm mt-2 max-w-xl mx-auto">
        Read how we help Denton County homeowners connect with reliable local plumbing professionals.
      </p>
      <div class="w-16 h-1 bg-[#c8102e] mx-auto mt-3 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {reviews.map((r) => (
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 flex flex-col justify-between shadow-sm hover:border-[#c8102e] hover:shadow-lg hover:shadow-red-600/5 transition duration-200">
          <div>
            <div class="flex items-center gap-1 text-amber-500 mb-3">
              <div class="flex items-center gap-0.5">
                <Icon name="star" class="w-4 h-4 text-amber-500 fill-amber-500" />
                <Icon name="star" class="w-4 h-4 text-amber-500 fill-amber-500" />
                <Icon name="star" class="w-4 h-4 text-amber-500 fill-amber-500" />
                <Icon name="star" class="w-4 h-4 text-amber-500 fill-amber-500" />
                <Icon name="star" class="w-4 h-4 text-amber-500 fill-amber-500" />
              </div>
              <span class="text-slate-600 text-xs ml-2 font-bold">(Local Homeowner)</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-2 font-serif">
              "{r.title}"
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed italic mb-6">
              "{r.text}"
            </p>
          </div>

          <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
            <div>
              <span class="block font-bold text-slate-900 text-sm">{r.author}</span>
              <span class="block text-xs text-slate-500">{r.location}</span>
            </div>
            <a href="/contact/" class="text-xs font-bold text-[#c8102e] hover:text-[#991b1b] hover:underline flex items-center gap-1">
              <span>Request Service</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
