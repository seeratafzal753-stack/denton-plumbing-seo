---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
  title?: string;
  subtitle?: string;
}

const {
  faqs,
  title = "Frequently Asked Questions",
  subtitle = "Have questions about plumbing repairs in Denton, TX? Find straightforward answers below."
} = Astro.props;
---

<section class="py-12 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Local Knowledge</span>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">{title}</h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2">{subtitle}</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group border border-slate-200 rounded-xl bg-slate-50 p-5 open:bg-white open:ring-1 open:ring-brand-500 transition">
          <summary class="flex justify-between items-center font-bold text-slate-900 cursor-pointer list-none text-base sm:text-lg">
            <span>{faq.question}</span>
            <span class="ml-4 shrink-0 text-brand-600 transition group-open:rotate-180">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </span>
          </summary>
          <div class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed pt-3 border-t border-slate-200">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
