---
const badges = [
  {
    icon: '⚡',
    title: '30–45 Min Dispatch',
    desc: 'Local trucks staged across Denton County',
  },
  {
    icon: '🛡️',
    title: 'Licensed & Insured',
    desc: 'Texas State Board of Plumbing Examiners certified',
  },
  {
    icon: '💵',
    title: '100% Upfront Pricing',
    desc: 'Transparent pricing with zero hidden surprises',
  },
  {
    icon: '⭐',
    title: '4.9/5 Star Rating',
    desc: 'Over 180+ verified local Denton homeowner reviews',
  },
];
---

<div class="bg-white border-y border-slate-200 py-6 px-4">
  <div class="max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-6">
    {badges.map((b) => (
      <div class="flex items-start gap-3">
        <div class="text-2xl p-2 bg-brand-50 rounded-lg shrink-0">
          {b.icon}
        </div>
        <div>
          <h4 class="font-bold text-slate-900 text-sm sm:text-base">{b.title}</h4>
          <p class="text-xs text-slate-500 leading-snug">{b.desc}</p>
        </div>
      </div>
    ))}
  </div>
</div>
