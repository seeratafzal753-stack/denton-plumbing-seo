---
import Icon from './Icon.astro';

const badges: Array<{
  icon: 'shield-check' | 'bolt' | 'flask' | 'dollar';
  title: string;
  desc: string;
}> = [
  {
    icon: 'shield-check',
    title: 'Independent Local Specialists',
    desc: 'Pre-screened Denton plumbing contractors',
  },
  {
    icon: 'bolt',
    title: 'Fast Dispatch Connection',
    desc: 'Connecting across I-35E, I-35W & Loop 288',
  },
  {
    icon: 'flask',
    title: 'North Texas Soil & Water Pros',
    desc: 'Slab leak & hard water repair experts',
  },
  {
    icon: 'dollar',
    title: 'Transparent Upfront Quotes',
    desc: 'Clear pricing before work begins',
  },
];
---

<div class="bg-white border-y border-slate-200 py-6 px-4">
  <div class="max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-6">
    {badges.map((b) => (
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 bg-brand-50 text-brand-700 rounded-xl shrink-0 border border-brand-100 shadow-sm flex items-center justify-center">
          <Icon name={b.icon} class="w-5 h-5" />
        </div>
        <div>
          <h4 class="font-black text-slate-900 text-sm sm:text-base leading-tight">{b.title}</h4>
          <p class="text-xs text-slate-500 leading-snug mt-0.5">{b.desc}</p>
        </div>
      </div>
    ))}
  </div>
</div>
